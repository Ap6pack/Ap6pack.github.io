[0.979008,"o","\n"]
[0.979028,"o","Usage: busybox [function] [arguments]...\n"]
[0.979074,"o","   or: busybox --list[-full]\n"]
[0.979093,"o","   or: busybox --install [-s] [DIR]\n"]
[0.979112,"o","   or: function [arguments]...\n"]
[0.97913,"o","\n"]
[0.979149,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.979167,"o","    utilities into a single executable.  Most people will create a\n"]
[0.979185,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.979203,"o","    will act like whatever it was invoked as.\n"]
[0.97922,"o","\n"]
[0.979238,"o","Currently defined functions:\n"]
[0.979256,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
