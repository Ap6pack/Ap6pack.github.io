[114.21276,"o","\u001b[4l"]
[114.212862,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[114.212891,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[114.212911,"o","and others. Licensed under GPLv2.\n"]
[114.212929,"o","See source distribution for full notice.\n"]
[114.212946,"o","\n"]
[114.212963,"o","Usage: busybox [function] [arguments]...\n"]
[114.21298,"o","   or: busybox --list[-full]\n"]
[114.212997,"o","   or: busybox --install [-s] [DIR]\n"]
[114.213014,"o","   or: function [arguments]...\n"]
[114.213031,"o","\n"]
[114.213048,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[114.213065,"o","    utilities into a single executable.  Most people will create a\n"]
[114.213098,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[114.213116,"o","    will act like whatever it was invoked as.\n"]
[114.213133,"o","\n"]
[114.213151,"o","Currently defined functions:\n"]
[114.213168,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[114.213185,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[114.213203,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[114.213219,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[114.213236,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[114.213253,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[114.21327,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[114.213287,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[114.213305,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[114.213322,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[114.213339,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[114.213356,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[114.213373,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[114.213391,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[114.213408,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[114.213425,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[114.213442,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[114.213459,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[114.213476,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[114.213493,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[114.213511,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[114.213529,"o","    zcat\n"]
