[1.566692,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.566725,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.566746,"o","and others. Licensed under GPLv2.\n"]
[1.566764,"o","See source distribution for full notice.\n"]
[1.566782,"o","\n"]
[1.566802,"o","Usage: busybox [function] [arguments]...\n"]
[1.566819,"o","   or: busybox --list[-full]\n"]
[1.566836,"o","   or: busybox --install [-s] [DIR]\n"]
[1.566854,"o","   or: function [arguments]...\n"]
[1.56687,"o","\n"]
[1.566887,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.566922,"o","    utilities into a single executable.  Most people will create a\n"]
[1.566941,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.566958,"o","    will act like whatever it was invoked as.\n"]
[1.566977,"o","\n"]
[1.566994,"o","Currently defined functions:\n"]
[1.567012,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.567029,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.567047,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.567064,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.567082,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.567099,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.567116,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.567133,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.56715,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.567167,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.567185,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.567202,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.56722,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.567237,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
