[75.568078,"o","\n"]
[75.568095,"o","Usage: busybox [function] [arguments]...\n"]
[75.568112,"o","   or: busybox --list[-full]\n"]
[75.568129,"o","   or: busybox --install [-s] [DIR]\n"]
[75.568146,"o","   or: function [arguments]...\n"]
[75.568162,"o","\n"]
[75.568179,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[75.568196,"o","    utilities into a single executable.  Most people will create a\n"]
[75.568229,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[75.568245,"o","    will act like whatever it was invoked as.\n"]
[75.568262,"o","\n"]
[75.568279,"o","Currently defined functions:\n"]
[75.568295,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[75.568312,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[75.568329,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[75.568346,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[75.568362,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[75.568379,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[75.568396,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[75.568413,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[75.568429,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[75.568445,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[75.568462,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
