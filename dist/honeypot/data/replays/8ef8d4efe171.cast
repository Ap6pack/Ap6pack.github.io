[89.148127,"o","\n"]
[89.148144,"o","Usage: busybox [function] [arguments]...\n"]
[89.14816,"o","   or: busybox --list[-full]\n"]
[89.148178,"o","   or: busybox --install [-s] [DIR]\n"]
[89.148194,"o","   or: function [arguments]...\n"]
[89.148211,"o","\n"]
[89.148228,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[89.148244,"o","    utilities into a single executable.  Most people will create a\n"]
[89.148261,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[89.148278,"o","    will act like whatever it was invoked as.\n"]
[89.148295,"o","\n"]
