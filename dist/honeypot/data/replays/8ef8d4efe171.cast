[101.571924,"o","\n"]
[101.571941,"o","Usage: busybox [function] [arguments]...\n"]
[101.571958,"o","   or: busybox --list[-full]\n"]
[101.571975,"o","   or: busybox --install [-s] [DIR]\n"]
[101.571992,"o","   or: function [arguments]...\n"]
[101.572009,"o","\n"]
[101.572026,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[101.572043,"o","    utilities into a single executable.  Most people will create a\n"]
[101.572071,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[101.572088,"o","    will act like whatever it was invoked as.\n"]
[101.572105,"o","\n"]
