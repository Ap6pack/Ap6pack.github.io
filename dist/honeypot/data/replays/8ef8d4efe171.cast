[83.850555,"o","\n"]
[83.850572,"o","Usage: busybox [function] [arguments]...\n"]
[83.850589,"o","   or: busybox --list[-full]\n"]
[83.850606,"o","   or: busybox --install [-s] [DIR]\n"]
[83.850625,"o","   or: function [arguments]...\n"]
[83.85067,"o","\n"]
[83.850688,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[83.850707,"o","    utilities into a single executable.  Most people will create a\n"]
[83.850726,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[83.850745,"o","    will act like whatever it was invoked as.\n"]
[83.850762,"o","\n"]
[83.850779,"o","Currently defined functions:\n"]
[83.850796,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
