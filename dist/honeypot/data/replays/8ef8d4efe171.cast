[77.681403,"o","See source distribution for full notice.\n"]
[77.681422,"o","\n"]
[77.681442,"o","Usage: busybox [function] [arguments]...\n"]
[77.681461,"o","   or: busybox --list[-full]\n"]
[77.681479,"o","   or: busybox --install [-s] [DIR]\n"]
[77.681497,"o","   or: function [arguments]...\n"]
[77.681515,"o","\n"]
[77.681532,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[77.68155,"o","    utilities into a single executable.  Most people will create a\n"]
[77.681569,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[77.681586,"o","    will act like whatever it was invoked as.\n"]
[77.681604,"o","\n"]
[77.681622,"o","Currently defined functions:\n"]
[77.681684,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[77.681707,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[77.681726,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[77.681743,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[77.68176,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[77.681777,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[77.681794,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[77.681811,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[77.681827,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[77.681844,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
