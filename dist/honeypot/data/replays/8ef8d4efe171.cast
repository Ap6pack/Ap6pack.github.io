[93.203316,"o","\n"]
[93.203334,"o","Usage: busybox [function] [arguments]...\n"]
[93.203353,"o","   or: busybox --list[-full]\n"]
[93.20337,"o","   or: busybox --install [-s] [DIR]\n"]
[93.203386,"o","   or: function [arguments]...\n"]
[93.20342,"o","\n"]
[93.203437,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[93.203454,"o","    utilities into a single executable.  Most people will create a\n"]
[93.20347,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[93.203487,"o","    will act like whatever it was invoked as.\n"]
