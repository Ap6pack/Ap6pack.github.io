[0.366742,"o","\n"]
[0.36676,"o","Usage: busybox [function] [arguments]...\n"]
[0.366777,"o","   or: busybox --list[-full]\n"]
[0.366796,"o","   or: busybox --install [-s] [DIR]\n"]
[0.366813,"o","   or: function [arguments]...\n"]
[0.36683,"o","\n"]
[0.366848,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.366865,"o","    utilities into a single executable.  Most people will create a\n"]
[0.366882,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.366898,"o","    will act like whatever it was invoked as.\n"]
[0.366915,"o","\n"]
[0.366931,"o","Currently defined functions:\n"]
[0.366949,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.366966,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.366983,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.366999,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.367017,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.367034,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.36705,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.367068,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.367085,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.367102,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.367119,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.367136,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.367153,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.36717,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.367187,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.367204,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.367221,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.367238,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.367256,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.367274,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.367292,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.367311,"o","    zcat\n"]
