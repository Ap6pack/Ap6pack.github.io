[87.696911,"o","\n"]
[87.696928,"o","Usage: busybox [function] [arguments]...\n"]
[87.696944,"o","   or: busybox --list[-full]\n"]
[87.696961,"o","   or: busybox --install [-s] [DIR]\n"]
[87.696978,"o","   or: function [arguments]...\n"]
[87.696995,"o","\n"]
[87.697011,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[87.697029,"o","    utilities into a single executable.  Most people will create a\n"]
[87.697046,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[87.697063,"o","    will act like whatever it was invoked as.\n"]
[87.697081,"o","\n"]
[87.697098,"o","Currently defined functions:\n"]
[87.697114,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
