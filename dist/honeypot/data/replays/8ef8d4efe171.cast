[21.851687,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[21.85172,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[21.851743,"o","and others. Licensed under GPLv2.\n"]
[21.851763,"o","See source distribution for full notice.\n"]
[21.851781,"o","\n"]
[21.8518,"o","Usage: busybox [function] [arguments]...\n"]
[21.851819,"o","   or: busybox --list[-full]\n"]
[21.851837,"o","   or: busybox --install [-s] [DIR]\n"]
[21.851855,"o","   or: function [arguments]...\n"]
[21.851874,"o","\n"]
[21.851892,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[21.85191,"o","    utilities into a single executable.  Most people will create a\n"]
[21.851928,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[21.851946,"o","    will act like whatever it was invoked as.\n"]
[21.851965,"o","\n"]
[21.851983,"o","Currently defined functions:\n"]
[21.852002,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[21.85202,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[21.852039,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[21.852058,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[21.852092,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[21.85211,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[21.852129,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[21.852146,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[21.852163,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[21.85218,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[21.852197,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
