[88.282982,"o","\n"]
[88.283002,"o","Usage: busybox [function] [arguments]...\n"]
[88.28302,"o","   or: busybox --list[-full]\n"]
[88.283038,"o","   or: busybox --install [-s] [DIR]\n"]
[88.283057,"o","   or: function [arguments]...\n"]
[88.283075,"o","\n"]
[88.283093,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.283112,"o","    utilities into a single executable.  Most people will create a\n"]
[88.28313,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.283147,"o","    will act like whatever it was invoked as.\n"]
[88.283165,"o","\n"]
[88.283182,"o","Currently defined functions:\n"]
[88.283199,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[88.283218,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
