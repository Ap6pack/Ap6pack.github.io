[108.161058,"o","   or: busybox --install [-s] [DIR]\n"]
[108.161076,"o","   or: function [arguments]...\n"]
[108.161092,"o","\n"]
[108.161109,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[108.161126,"o","    utilities into a single executable.  Most people will create a\n"]
[108.161143,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[108.16116,"o","    will act like whatever it was invoked as.\n"]
