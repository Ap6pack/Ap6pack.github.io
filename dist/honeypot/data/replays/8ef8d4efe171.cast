[81.79574,"o","\n"]
[81.795758,"o","Usage: busybox [function] [arguments]...\n"]
[81.795775,"o","   or: busybox --list[-full]\n"]
[81.795792,"o","   or: busybox --install [-s] [DIR]\n"]
[81.79581,"o","   or: function [arguments]...\n"]
[81.795826,"o","\n"]
[81.795844,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[81.795861,"o","    utilities into a single executable.  Most people will create a\n"]
[81.795878,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[81.795894,"o","    will act like whatever it was invoked as.\n"]
[81.795912,"o","\n"]
[81.795929,"o","Currently defined functions:\n"]
[81.795947,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[81.795964,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[81.795981,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[81.795998,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
