[112.742614,"o","\n"]
[112.742648,"o","Usage: busybox [function] [arguments]...\n"]
[112.742672,"o","   or: busybox --list[-full]\n"]
[112.74269,"o","   or: busybox --install [-s] [DIR]\n"]
[112.742707,"o","   or: function [arguments]...\n"]
[112.742724,"o","\n"]
[112.742741,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[112.742758,"o","    utilities into a single executable.  Most people will create a\n"]
[112.742774,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[112.742791,"o","    will act like whatever it was invoked as.\n"]
[112.742808,"o","\n"]
[112.742825,"o","Currently defined functions:\n"]
[112.742842,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[112.742859,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[112.742875,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[112.742892,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[112.742908,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
