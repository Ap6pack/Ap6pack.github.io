[1.060093,"o","Usage: ping [-LRUbdfnqrvVaA] [-c count] [-i interval] [-w deadline]\n"]
[1.060121,"o","            [-p pattern] [-s packetsize] [-t ttl] [-I interface or address]\n"]
[1.060141,"o","            [-M mtu discovery hint] [-S sndbuf]\n"]
[1.060158,"o","            [ -T timestamp option ] [ -Q tos ] [hop1 ...] destination\n"]
