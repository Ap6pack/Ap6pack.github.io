[53.338831,"o","\u001b[4l"]
[53.338911,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[53.338935,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[53.338954,"o","and others. Licensed under GPLv2.\n"]
[53.338973,"o","See source distribution for full notice.\n"]
[53.33899,"o","\n"]
[53.339007,"o","Usage: busybox [function] [arguments]...\n"]
[53.339023,"o","   or: busybox --list[-full]\n"]
[53.33904,"o","   or: busybox --install [-s] [DIR]\n"]
[53.339057,"o","   or: function [arguments]...\n"]
[53.339073,"o","\n"]
[53.33909,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[53.339123,"o","    utilities into a single executable.  Most people will create a\n"]
[53.33914,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[53.339157,"o","    will act like whatever it was invoked as.\n"]
[53.339174,"o","\n"]
[53.33919,"o","Currently defined functions:\n"]
[53.339207,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[53.339224,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[53.33924,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[53.339257,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[53.339273,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[53.339289,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[53.339306,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[53.339322,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[53.339338,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[53.339355,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[53.339372,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[53.339388,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[53.339405,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[53.339421,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[53.339439,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[53.339456,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[53.339473,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
