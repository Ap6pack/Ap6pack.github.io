[0.74387,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.743901,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.743921,"o","and others. Licensed under GPLv2.\n"]
[0.74394,"o","See source distribution for full notice.\n"]
[0.743958,"o","\n"]
[0.743977,"o","Usage: busybox [function] [arguments]...\n"]
[0.743994,"o","   or: busybox --list[-full]\n"]
[0.744011,"o","   or: busybox --install [-s] [DIR]\n"]
[0.744028,"o","   or: function [arguments]...\n"]
[0.744044,"o","\n"]
[0.744061,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.744078,"o","    utilities into a single executable.  Most people will create a\n"]
[0.744128,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.744156,"o","    will act like whatever it was invoked as.\n"]
[0.744175,"o","\n"]
[0.744193,"o","Currently defined functions:\n"]
[0.744212,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.744231,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.744249,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.744267,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.744285,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.744305,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.744322,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.744342,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.74436,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.744379,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.744397,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.744415,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.744433,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.744451,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.744469,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.744487,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.744506,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.744526,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.744544,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
