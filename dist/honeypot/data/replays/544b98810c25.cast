[4.436509,"o","\u001b[4l"]
[4.436626,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[4.436655,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[4.436684,"o","and others. Licensed under GPLv2.\n"]
[4.436708,"o","See source distribution for full notice.\n"]
[4.436732,"o","\n"]
[4.436754,"o","Usage: busybox [function] [arguments]...\n"]
[4.436773,"o","   or: busybox --list[-full]\n"]
[4.4368,"o","   or: busybox --install [-s] [DIR]\n"]
[4.436822,"o","   or: function [arguments]...\n"]
[4.436843,"o","\n"]
[4.436861,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.436877,"o","    utilities into a single executable.  Most people will create a\n"]
[4.4369,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.436926,"o","    will act like whatever it was invoked as.\n"]
[4.436944,"o","\n"]
[4.436961,"o","Currently defined functions:\n"]
[4.436981,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[4.437005,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[4.437022,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[4.437038,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[4.437055,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[4.437072,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[4.437093,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[4.437129,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[4.437155,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
