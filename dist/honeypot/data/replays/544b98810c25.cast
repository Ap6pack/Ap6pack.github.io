[3.363562,"o","\u001b[4l"]
[3.363655,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[3.363682,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[3.363702,"o","and others. Licensed under GPLv2.\n"]
[3.363719,"o","See source distribution for full notice.\n"]
[3.363737,"o","\n"]
[3.363754,"o","Usage: busybox [function] [arguments]...\n"]
[3.363771,"o","   or: busybox --list[-full]\n"]
[3.363788,"o","   or: busybox --install [-s] [DIR]\n"]
[3.363805,"o","   or: function [arguments]...\n"]
[3.363851,"o","\n"]
[3.363872,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[3.36389,"o","    utilities into a single executable.  Most people will create a\n"]
[3.363906,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[3.363927,"o","    will act like whatever it was invoked as.\n"]
[3.363948,"o","\n"]
[3.363965,"o","Currently defined functions:\n"]
[3.363983,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[3.364001,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[3.364018,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[3.364035,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[3.364057,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[3.364093,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[3.364111,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[3.364152,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[3.364171,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[3.36419,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[3.36421,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[3.364231,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[3.364248,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[3.364266,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[3.364285,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[3.364303,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[3.364322,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[3.364346,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[3.364363,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[3.364385,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[3.364403,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[3.36442,"o","    zcat\n"]
[3.364451,"o","\u001b[4h"]
[3.364514,"o","root@honeypot-01:/home# "]
