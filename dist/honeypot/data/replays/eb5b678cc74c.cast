[4.279439,"o","\u001b[4l"]
[4.279567,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[4.279599,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[4.279621,"o","and others. Licensed under GPLv2.\n"]
[4.279666,"o","See source distribution for full notice.\n"]
[4.279688,"o","\n"]
[4.279706,"o","Usage: busybox [function] [arguments]...\n"]
[4.279724,"o","   or: busybox --list[-full]\n"]
[4.279741,"o","   or: busybox --install [-s] [DIR]\n"]
[4.279758,"o","   or: function [arguments]...\n"]
[4.279774,"o","\n"]
[4.279797,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.279815,"o","    utilities into a single executable.  Most people will create a\n"]
[4.279832,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.279849,"o","    will act like whatever it was invoked as.\n"]
[4.279866,"o","\n"]
[4.279883,"o","Currently defined functions:\n"]
[4.2799,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[4.279917,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[4.279933,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[4.27995,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[4.279967,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[4.279984,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[4.280001,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[4.280019,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[4.280037,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[4.280053,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[4.280071,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[4.280088,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[4.280105,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[4.280126,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[4.280143,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[4.280161,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[4.280181,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[4.280199,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[4.280216,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[4.280232,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[4.280249,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[4.280266,"o","    zcat\n"]
[4.280298,"o","\u001b[4h"]
