[0.580823,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.580847,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.580866,"o","and others. Licensed under GPLv2.\n"]
[0.580884,"o","See source distribution for full notice.\n"]
[0.580901,"o","\n"]
[0.580918,"o","Usage: busybox [function] [arguments]...\n"]
[0.580935,"o","   or: busybox --list[-full]\n"]
[0.580951,"o","   or: busybox --install [-s] [DIR]\n"]
[0.580968,"o","   or: function [arguments]...\n"]
[0.580984,"o","\n"]
[0.581001,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.581018,"o","    utilities into a single executable.  Most people will create a\n"]
[0.581056,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.581073,"o","    will act like whatever it was invoked as.\n"]
[0.58109,"o","\n"]
[0.581106,"o","Currently defined functions:\n"]
[0.581124,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.581141,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.581158,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.581175,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.581192,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.581208,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.581226,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.581243,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.58126,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.581276,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.581293,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.58131,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.581327,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.581344,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.581361,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.581378,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.581396,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.581414,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.58143,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.581447,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
