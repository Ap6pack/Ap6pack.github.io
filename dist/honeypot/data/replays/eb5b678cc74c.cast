[2.367285,"o","\u001b[4l"]
[2.367388,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[2.36742,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[2.367449,"o","and others. Licensed under GPLv2.\n"]
[2.367469,"o","See source distribution for full notice.\n"]
[2.367509,"o","\n"]
[2.367547,"o","Usage: busybox [function] [arguments]...\n"]
[2.367566,"o","   or: busybox --list[-full]\n"]
[2.367584,"o","   or: busybox --install [-s] [DIR]\n"]
[2.367611,"o","   or: function [arguments]...\n"]
[2.367631,"o","\n"]
[2.367685,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[2.367707,"o","    utilities into a single executable.  Most people will create a\n"]
[2.367725,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[2.367756,"o","    will act like whatever it was invoked as.\n"]
[2.367774,"o","\n"]
[2.367795,"o","Currently defined functions:\n"]
[2.367814,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[2.367839,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[2.367859,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[2.367889,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[2.367912,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[2.367932,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[2.36795,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[2.367967,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[2.368005,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[2.368027,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[2.368048,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[2.368065,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[2.368086,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[2.368111,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[2.368135,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[2.368153,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[2.368175,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[2.368201,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[2.368225,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[2.368253,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[2.368273,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[2.368294,"o","    zcat\n"]
[2.368329,"o","\u001b[4h"]
[2.368401,"o","root@TBOT:/home# "]
