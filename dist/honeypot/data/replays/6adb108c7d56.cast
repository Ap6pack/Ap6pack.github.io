[73.952779,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[73.952804,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[73.952823,"o","and others. Licensed under GPLv2.\n"]
[73.952841,"o","See source distribution for full notice.\n"]
[73.952858,"o","\n"]
[73.952874,"o","Usage: busybox [function] [arguments]...\n"]
[73.952891,"o","   or: busybox --list[-full]\n"]
[73.952908,"o","   or: busybox --install [-s] [DIR]\n"]
[73.952925,"o","   or: function [arguments]...\n"]
[73.952942,"o","\n"]
[73.952958,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[73.952975,"o","    utilities into a single executable.  Most people will create a\n"]
[73.952992,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[73.953008,"o","    will act like whatever it was invoked as.\n"]
[73.953025,"o","\n"]
[73.953042,"o","Currently defined functions:\n"]
[73.953058,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[73.953076,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[73.953093,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[73.953109,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[73.953126,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[73.953143,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[73.953159,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[73.953183,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[73.953201,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[73.953218,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
