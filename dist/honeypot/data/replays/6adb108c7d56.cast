[4.476849,"o","\u001b[4l"]
[4.47694,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[4.476965,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[4.476984,"o","and others. Licensed under GPLv2.\n"]
[4.477001,"o","See source distribution for full notice.\n"]
[4.477018,"o","\n"]
[4.477035,"o","Usage: busybox [function] [arguments]...\n"]
[4.477052,"o","   or: busybox --list[-full]\n"]
[4.477071,"o","   or: busybox --install [-s] [DIR]\n"]
[4.477087,"o","   or: function [arguments]...\n"]
[4.477104,"o","\n"]
[4.477122,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.477154,"o","    utilities into a single executable.  Most people will create a\n"]
[4.477171,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.477188,"o","    will act like whatever it was invoked as.\n"]
[4.477205,"o","\n"]
[4.477221,"o","Currently defined functions:\n"]
[4.477238,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[4.477255,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[4.477289,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[4.477315,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[4.477334,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[4.477351,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[4.477369,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[4.477385,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[4.477403,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[4.47742,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[4.477436,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[4.477453,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[4.477471,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[4.477487,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
