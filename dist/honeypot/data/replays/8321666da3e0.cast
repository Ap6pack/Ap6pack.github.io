[0.803765,"o","\n"]
[0.803784,"o","Usage: busybox [function] [arguments]...\n"]
[0.803801,"o","   or: busybox --list[-full]\n"]
[0.803818,"o","   or: busybox --install [-s] [DIR]\n"]
[0.803836,"o","   or: function [arguments]...\n"]
[0.803852,"o","\n"]
[0.80387,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.803887,"o","    utilities into a single executable.  Most people will create a\n"]
[0.803905,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.803922,"o","    will act like whatever it was invoked as.\n"]
