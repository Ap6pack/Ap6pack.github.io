[18.261705,"o","\u001b[4l"]
[18.261786,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[18.26181,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[18.261831,"o","and others. Licensed under GPLv2.\n"]
[18.261849,"o","See source distribution for full notice.\n"]
[18.261865,"o","\n"]
[18.261882,"o","Usage: busybox [function] [arguments]...\n"]
[18.261899,"o","   or: busybox --list[-full]\n"]
[18.261922,"o","   or: busybox --install [-s] [DIR]\n"]
[18.261942,"o","   or: function [arguments]...\n"]
[18.261958,"o","\n"]
[18.261975,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[18.261998,"o","    utilities into a single executable.  Most people will create a\n"]
[18.262024,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[18.262041,"o","    will act like whatever it was invoked as.\n"]
[18.262062,"o","\n"]
[18.262079,"o","Currently defined functions:\n"]
[18.262104,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[18.262121,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[18.262138,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[18.262154,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[18.262175,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[18.262196,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[18.262214,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[18.262231,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[18.262255,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[18.262299,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[18.262318,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[18.262336,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[18.26236,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[18.262378,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[18.262395,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[18.262414,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[18.262436,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[18.262453,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[18.262471,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[18.262497,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[18.262517,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[18.262539,"o","    zcat\n"]
[18.262567,"o","\u001b[4h"]
[18.262633,"o","root@ip-172-31-80-180:/home# "]
