[80.096918,"o","\n"]
[80.096935,"o","Usage: busybox [function] [arguments]...\n"]
[80.096953,"o","   or: busybox --list[-full]\n"]
[80.096971,"o","   or: busybox --install [-s] [DIR]\n"]
[80.096987,"o","   or: function [arguments]...\n"]
[80.097005,"o","\n"]
[80.097021,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[80.097039,"o","    utilities into a single executable.  Most people will create a\n"]
[80.097056,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[80.097073,"o","    will act like whatever it was invoked as.\n"]
[80.09709,"o","\n"]
[80.097106,"o","Currently defined functions:\n"]
[80.097123,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[80.09714,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[80.097156,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[80.097173,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[80.097189,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[80.097207,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[80.09724,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[80.097259,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
