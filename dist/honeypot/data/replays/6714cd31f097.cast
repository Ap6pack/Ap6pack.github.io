[80.799665,"o","\n"]
[80.799683,"o","Usage: busybox [function] [arguments]...\n"]
[80.7997,"o","   or: busybox --list[-full]\n"]
[80.799717,"o","   or: busybox --install [-s] [DIR]\n"]
[80.799734,"o","   or: function [arguments]...\n"]
[80.79975,"o","\n"]
[80.799767,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[80.799784,"o","    utilities into a single executable.  Most people will create a\n"]
[80.799801,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[80.799818,"o","    will act like whatever it was invoked as.\n"]
