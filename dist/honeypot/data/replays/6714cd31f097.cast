[87.910521,"o","\n"]
[87.910539,"o","Usage: busybox [function] [arguments]...\n"]
[87.910556,"o","   or: busybox --list[-full]\n"]
[87.910573,"o","   or: busybox --install [-s] [DIR]\n"]
[87.91059,"o","   or: function [arguments]...\n"]
[87.910607,"o","\n"]
[87.910624,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[87.910641,"o","    utilities into a single executable.  Most people will create a\n"]
[87.910658,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[87.910675,"o","    will act like whatever it was invoked as.\n"]
[87.910692,"o","\n"]
