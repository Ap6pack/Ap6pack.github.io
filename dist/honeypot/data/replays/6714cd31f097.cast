[70.82292,"o","\n"]
[70.822938,"o","Usage: busybox [function] [arguments]...\n"]
[70.822956,"o","   or: busybox --list[-full]\n"]
[70.822973,"o","   or: busybox --install [-s] [DIR]\n"]
[70.82299,"o","   or: function [arguments]...\n"]
[70.823007,"o","\n"]
[70.823025,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[70.823042,"o","    utilities into a single executable.  Most people will create a\n"]
[70.82306,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[70.823077,"o","    will act like whatever it was invoked as.\n"]
[70.823094,"o","\n"]
[70.823111,"o","Currently defined functions:\n"]
[70.823145,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[70.823165,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[70.823183,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[70.823201,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[70.823218,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[70.823237,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[70.823256,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[70.823274,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
