[103.59229,"o","\n"]
[103.592307,"o","Usage: busybox [function] [arguments]...\n"]
[103.592324,"o","   or: busybox --list[-full]\n"]
[103.592341,"o","   or: busybox --install [-s] [DIR]\n"]
[103.592357,"o","   or: function [arguments]...\n"]
[103.592375,"o","\n"]
[103.592392,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[103.592409,"o","    utilities into a single executable.  Most people will create a\n"]
[103.592426,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[103.592443,"o","    will act like whatever it was invoked as.\n"]
