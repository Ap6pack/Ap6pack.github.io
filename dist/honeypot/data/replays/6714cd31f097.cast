[99.005629,"o","\n"]
[99.005646,"o","Usage: busybox [function] [arguments]...\n"]
[99.005664,"o","   or: busybox --list[-full]\n"]
[99.005681,"o","   or: busybox --install [-s] [DIR]\n"]
[99.005699,"o","   or: function [arguments]...\n"]
[99.005715,"o","\n"]
[99.005733,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[99.005751,"o","    utilities into a single executable.  Most people will create a\n"]
[99.005769,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[99.005786,"o","    will act like whatever it was invoked as.\n"]
[99.005803,"o","\n"]
[99.005819,"o","Currently defined functions:\n"]
[99.005858,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[99.005886,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[99.005906,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[99.005924,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[99.005942,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[99.005964,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[99.005982,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[99.006001,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
