[68.855856,"o","\n"]
[68.855883,"o","Usage: busybox [function] [arguments]...\n"]
[68.855901,"o","   or: busybox --list[-full]\n"]
[68.855918,"o","   or: busybox --install [-s] [DIR]\n"]
[68.855936,"o","   or: function [arguments]...\n"]
[68.855953,"o","\n"]
[68.85597,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[68.855998,"o","    utilities into a single executable.  Most people will create a\n"]
[68.856018,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[68.856035,"o","    will act like whatever it was invoked as.\n"]
[68.856052,"o","\n"]
[68.856069,"o","Currently defined functions:\n"]
