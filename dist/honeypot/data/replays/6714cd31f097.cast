[115.706115,"o","\n"]
[115.706132,"o","Usage: busybox [function] [arguments]...\n"]
[115.706148,"o","   or: busybox --list[-full]\n"]
[115.706165,"o","   or: busybox --install [-s] [DIR]\n"]
[115.706182,"o","   or: function [arguments]...\n"]
[115.706198,"o","\n"]
[115.706215,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[115.706232,"o","    utilities into a single executable.  Most people will create a\n"]
[115.706249,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[115.706265,"o","    will act like whatever it was invoked as.\n"]
