[83.628572,"o","\n"]
[83.628589,"o","Usage: busybox [function] [arguments]...\n"]
[83.628606,"o","   or: busybox --list[-full]\n"]
[83.628624,"o","   or: busybox --install [-s] [DIR]\n"]
[83.628641,"o","   or: function [arguments]...\n"]
[83.628657,"o","\n"]
[83.628675,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[83.628692,"o","    utilities into a single executable.  Most people will create a\n"]
[83.628709,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[83.628726,"o","    will act like whatever it was invoked as.\n"]
[83.628745,"o","\n"]
[83.628762,"o","Currently defined functions:\n"]
[83.628778,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
