[0.33782,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.337879,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.338012,"o","and others. Licensed under GPLv2.\n"]
