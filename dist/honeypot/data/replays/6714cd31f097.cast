[76.330254,"o","and others. Licensed under GPLv2.\n"]
[76.330273,"o","See source distribution for full notice.\n"]
[76.330295,"o","\n"]
[76.330312,"o","Usage: busybox [function] [arguments]...\n"]
[76.330331,"o","   or: busybox --list[-full]\n"]
[76.330349,"o","   or: busybox --install [-s] [DIR]\n"]
[76.330369,"o","   or: function [arguments]...\n"]
[76.330385,"o","\n"]
[76.330402,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[76.330419,"o","    utilities into a single executable.  Most people will create a\n"]
[76.330436,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[76.330452,"o","    will act like whatever it was invoked as.\n"]
[76.330469,"o","\n"]
[76.330486,"o","Currently defined functions:\n"]
[76.330503,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[76.33052,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[76.330537,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[76.330554,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[76.330571,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[76.33059,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[76.330608,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[76.330625,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[76.330643,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[76.330665,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
