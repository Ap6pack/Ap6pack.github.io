[74.562147,"o","\n"]
[74.562165,"o","Usage: busybox [function] [arguments]...\n"]
[74.562182,"o","   or: busybox --list[-full]\n"]
[74.562199,"o","   or: busybox --install [-s] [DIR]\n"]
[74.562215,"o","   or: function [arguments]...\n"]
[74.562232,"o","\n"]
[74.562249,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[74.562266,"o","    utilities into a single executable.  Most people will create a\n"]
[74.562283,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[74.562301,"o","    will act like whatever it was invoked as.\n"]
[74.562318,"o","\n"]
[74.562335,"o","Currently defined functions:\n"]
[74.562352,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[74.562368,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[74.562385,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[74.562402,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[74.562419,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[74.562438,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[74.562456,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[74.562473,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
