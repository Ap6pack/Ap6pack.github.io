[82.091268,"o","\n"]
[82.091291,"o","Usage: busybox [function] [arguments]...\n"]
[82.091309,"o","   or: busybox --list[-full]\n"]
[82.091326,"o","   or: busybox --install [-s] [DIR]\n"]
[82.091342,"o","   or: function [arguments]...\n"]
[82.091359,"o","\n"]
[82.091376,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[82.091393,"o","    utilities into a single executable.  Most people will create a\n"]
[82.091425,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[82.091443,"o","    will act like whatever it was invoked as.\n"]
[82.091459,"o","\n"]
[82.091476,"o","Currently defined functions:\n"]
[82.091493,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[82.091509,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[82.091526,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[82.091543,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[82.091559,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[82.091576,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[82.091594,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[82.091612,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
