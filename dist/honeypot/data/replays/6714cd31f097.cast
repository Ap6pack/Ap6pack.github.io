[1.744991,"o","\u001b[4l"]
[1.745078,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.745103,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.745124,"o","and others. Licensed under GPLv2.\n"]
[1.745143,"o","See source distribution for full notice.\n"]
[1.74516,"o","\n"]
[1.745178,"o","Usage: busybox [function] [arguments]...\n"]
[1.745196,"o","   or: busybox --list[-full]\n"]
[1.745213,"o","   or: busybox --install [-s] [DIR]\n"]
[1.745232,"o","   or: function [arguments]...\n"]
[1.745249,"o","\n"]
[1.745266,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.745299,"o","    utilities into a single executable.  Most people will create a\n"]
[1.745316,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.745332,"o","    will act like whatever it was invoked as.\n"]
[1.745349,"o","\n"]
[1.745365,"o","Currently defined functions:\n"]
[1.745381,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.745399,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.745415,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.745432,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.745448,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.745466,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.745483,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.745501,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.745518,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.745536,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.745553,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.74557,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.745587,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.745604,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
