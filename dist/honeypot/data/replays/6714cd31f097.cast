[95.995202,"o","   or: busybox --install [-s] [DIR]\n"]
[95.99522,"o","   or: function [arguments]...\n"]
[95.995238,"o","\n"]
[95.995255,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[95.995272,"o","    utilities into a single executable.  Most people will create a\n"]
[95.995289,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[95.995306,"o","    will act like whatever it was invoked as.\n"]
[95.995324,"o","\n"]
[95.995341,"o","Currently defined functions:\n"]
[95.995358,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
