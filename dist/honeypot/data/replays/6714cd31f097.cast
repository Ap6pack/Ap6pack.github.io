[105.205812,"o","\n"]
[105.20583,"o","Usage: busybox [function] [arguments]...\n"]
[105.205887,"o","   or: busybox --list[-full]\n"]
[105.20591,"o","   or: busybox --install [-s] [DIR]\n"]
[105.20593,"o","   or: function [arguments]...\n"]
[105.205947,"o","\n"]
[105.205966,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[105.205984,"o","    utilities into a single executable.  Most people will create a\n"]
[105.206002,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[105.206019,"o","    will act like whatever it was invoked as.\n"]
[105.206049,"o","\n"]
[105.206072,"o","Currently defined functions:\n"]
[105.206091,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[105.206109,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
