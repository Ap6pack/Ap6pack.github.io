[0.796946,"o","\n"]
[0.796963,"o","Usage: busybox [function] [arguments]...\n"]
[0.796981,"o","   or: busybox --list[-full]\n"]
[0.796998,"o","   or: busybox --install [-s] [DIR]\n"]
[0.797016,"o","   or: function [arguments]...\n"]
[0.797033,"o","\n"]
[0.79705,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.797067,"o","    utilities into a single executable.  Most people will create a\n"]
[0.797085,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.797102,"o","    will act like whatever it was invoked as.\n"]
