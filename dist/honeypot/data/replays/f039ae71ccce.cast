[1.208992,"o","\n"]
[1.209009,"o","Usage: busybox [function] [arguments]...\n"]
[1.209027,"o","   or: busybox --list[-full]\n"]
[1.209044,"o","   or: busybox --install [-s] [DIR]\n"]
[1.20906,"o","   or: function [arguments]...\n"]
[1.209077,"o","\n"]
[1.209093,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.20911,"o","    utilities into a single executable.  Most people will create a\n"]
[1.209127,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.209144,"o","    will act like whatever it was invoked as.\n"]
