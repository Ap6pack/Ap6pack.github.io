[0.68169,"o","\n"]
[0.681707,"o","Usage: busybox [function] [arguments]...\n"]
[0.681725,"o","   or: busybox --list[-full]\n"]
[0.681742,"o","   or: busybox --install [-s] [DIR]\n"]
[0.681759,"o","   or: function [arguments]...\n"]
[0.681775,"o","\n"]
[0.681793,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.68181,"o","    utilities into a single executable.  Most people will create a\n"]
[0.681827,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.681844,"o","    will act like whatever it was invoked as.\n"]
[0.681862,"o","\n"]
