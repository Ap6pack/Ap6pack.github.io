[0.738379,"o","\n"]
[0.738396,"o","Usage: busybox [function] [arguments]...\n"]
[0.738413,"o","   or: busybox --list[-full]\n"]
[0.73843,"o","   or: busybox --install [-s] [DIR]\n"]
[0.738447,"o","   or: function [arguments]...\n"]
[0.738463,"o","\n"]
[0.73848,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.738497,"o","    utilities into a single executable.  Most people will create a\n"]
[0.738515,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.738532,"o","    will act like whatever it was invoked as.\n"]
[0.738549,"o","\n"]
