[3.197902,"o","\u001b[4l"]
[3.198018,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[3.198046,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[3.198066,"o","and others. Licensed under GPLv2.\n"]
[3.198085,"o","See source distribution for full notice.\n"]
[3.198103,"o","\n"]
[3.19812,"o","Usage: busybox [function] [arguments]...\n"]
[3.198137,"o","   or: busybox --list[-full]\n"]
[3.198182,"o","   or: busybox --install [-s] [DIR]\n"]
[3.198202,"o","   or: function [arguments]...\n"]
[3.19822,"o","\n"]
[3.198238,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[3.198272,"o","    utilities into a single executable.  Most people will create a\n"]
[3.19829,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[3.198308,"o","    will act like whatever it was invoked as.\n"]
[3.198326,"o","\n"]
[3.198343,"o","Currently defined functions:\n"]
[3.19836,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[3.198378,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[3.198395,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[3.198413,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[3.19843,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[3.198448,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[3.198466,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[3.198483,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[3.198501,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[3.198519,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[3.198536,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[3.198554,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
