[23.791031,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[23.791057,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[23.791076,"o","and others. Licensed under GPLv2.\n"]
[23.791095,"o","See source distribution for full notice.\n"]
[23.791117,"o","\n"]
[23.791135,"o","Usage: busybox [function] [arguments]...\n"]
[23.791172,"o","   or: busybox --list[-full]\n"]
[23.791191,"o","   or: busybox --install [-s] [DIR]\n"]
[23.791208,"o","   or: function [arguments]...\n"]
[23.791225,"o","\n"]
[23.791242,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[23.791259,"o","    utilities into a single executable.  Most people will create a\n"]
[23.791277,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[23.791294,"o","    will act like whatever it was invoked as.\n"]
[23.791313,"o","\n"]
[23.791331,"o","Currently defined functions:\n"]
[23.791347,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[23.791365,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[23.791382,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[23.791399,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[23.791431,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[23.791453,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[23.791473,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[23.791492,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[23.791509,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[23.791527,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[23.791545,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[23.791562,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[23.791579,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
