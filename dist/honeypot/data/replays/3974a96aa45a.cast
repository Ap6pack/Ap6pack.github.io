[71.879244,"o","\n"]
[71.87926,"o","Usage: busybox [function] [arguments]...\n"]
[71.879278,"o","   or: busybox --list[-full]\n"]
[71.879295,"o","   or: busybox --install [-s] [DIR]\n"]
[71.879312,"o","   or: function [arguments]...\n"]
[71.879329,"o","\n"]
[71.879346,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[71.879364,"o","    utilities into a single executable.  Most people will create a\n"]
[71.879381,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[71.879398,"o","    will act like whatever it was invoked as.\n"]
[71.879414,"o","\n"]
[71.879431,"o","Currently defined functions:\n"]
[71.879447,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[71.879465,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[71.879481,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[71.879514,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[71.879531,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[71.879548,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[71.879566,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[71.879584,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[71.879601,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
