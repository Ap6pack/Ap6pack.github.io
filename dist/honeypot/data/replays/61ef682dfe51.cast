[1.927563,"o","\n"]
[1.92758,"o","Usage: busybox [function] [arguments]...\n"]
[1.927598,"o","   or: busybox --list[-full]\n"]
[1.927614,"o","   or: busybox --install [-s] [DIR]\n"]
[1.927631,"o","   or: function [arguments]...\n"]
[1.927648,"o","\n"]
[1.927664,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.927681,"o","    utilities into a single executable.  Most people will create a\n"]
[1.927697,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.927714,"o","    will act like whatever it was invoked as.\n"]
[1.927731,"o","\n"]
