[3.14134,"o","\u001b[4l"]
[3.141419,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[3.141445,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[3.141464,"o","and others. Licensed under GPLv2.\n"]
[3.141481,"o","See source distribution for full notice.\n"]
[3.141498,"o","\n"]
[3.141515,"o","Usage: busybox [function] [arguments]...\n"]
[3.141532,"o","   or: busybox --list[-full]\n"]
[3.141549,"o","   or: busybox --install [-s] [DIR]\n"]
[3.141565,"o","   or: function [arguments]...\n"]
[3.141581,"o","\n"]
[3.141598,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[3.14164,"o","    utilities into a single executable.  Most people will create a\n"]
[3.14166,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[3.141678,"o","    will act like whatever it was invoked as.\n"]
[3.141695,"o","\n"]
[3.141712,"o","Currently defined functions:\n"]
[3.141728,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[3.141745,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[3.141762,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[3.141778,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[3.141795,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[3.141812,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[3.14183,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[3.141847,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[3.141869,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[3.141911,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[3.141936,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[3.141953,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[3.14197,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
