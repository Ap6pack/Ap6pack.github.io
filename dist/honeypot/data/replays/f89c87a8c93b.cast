[13.505637,"o","\u001b[4l"]
[13.505734,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[13.505766,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[13.505788,"o","and others. Licensed under GPLv2.\n"]
[13.505836,"o","See source distribution for full notice.\n"]
[13.505859,"o","\n"]
[13.505894,"o","Usage: busybox [function] [arguments]...\n"]
[13.505915,"o","   or: busybox --list[-full]\n"]
[13.505934,"o","   or: busybox --install [-s] [DIR]\n"]
[13.50597,"o","   or: function [arguments]...\n"]
[13.505992,"o","\n"]
[13.506016,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[13.506035,"o","    utilities into a single executable.  Most people will create a\n"]
[13.506052,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[13.506079,"o","    will act like whatever it was invoked as.\n"]
[13.506104,"o","\n"]
[13.506123,"o","Currently defined functions:\n"]
[13.50614,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[13.506159,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[13.506176,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[13.506193,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[13.50621,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[13.506253,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[13.506279,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[13.506297,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[13.506314,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[13.506331,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[13.506349,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[13.50637,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[13.506392,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[13.506409,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[13.506431,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[13.50645,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[13.506467,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[13.506484,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[13.506509,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[13.506535,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[13.506561,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[13.506583,"o","    zcat\n"]
[13.506618,"o","\u001b[4h"]
[13.506682,"o","default@honeypot-01:~$ "]