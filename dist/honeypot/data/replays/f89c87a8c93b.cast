[1.434064,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.434092,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.434112,"o","and others. Licensed under GPLv2.\n"]
[1.434131,"o","See source distribution for full notice.\n"]
[1.434149,"o","\n"]
[1.434168,"o","Usage: busybox [function] [arguments]...\n"]
[1.434188,"o","   or: busybox --list[-full]\n"]
[1.434207,"o","   or: busybox --install [-s] [DIR]\n"]
[1.434225,"o","   or: function [arguments]...\n"]
[1.434242,"o","\n"]
[1.434261,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.434325,"o","    utilities into a single executable.  Most people will create a\n"]
[1.434351,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.43437,"o","    will act like whatever it was invoked as.\n"]
[1.434389,"o","\n"]
[1.434407,"o","Currently defined functions:\n"]
[1.434425,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.434444,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.434462,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.434482,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.434501,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.434519,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.434537,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.434554,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.434573,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.43459,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.434607,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.434625,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.434642,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.434659,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.434677,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.434694,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[1.434711,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[1.434728,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[1.434746,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[1.434763,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[1.434781,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[1.434824,"o","    zcat\n"]
