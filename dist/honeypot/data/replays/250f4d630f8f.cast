[0.766359,"o","\n"]
[0.766382,"o","Usage: busybox [function] [arguments]...\n"]
[0.766406,"o","   or: busybox --list[-full]\n"]
[0.766437,"o","   or: busybox --install [-s] [DIR]\n"]
[0.766464,"o","   or: function [arguments]...\n"]
[0.766486,"o","\n"]
[0.766506,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.766527,"o","    utilities into a single executable.  Most people will create a\n"]
[0.766546,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.766583,"o","    will act like whatever it was invoked as.\n"]
[0.766611,"o","\n"]
[0.76665,"o","Currently defined functions:\n"]
[0.766673,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
