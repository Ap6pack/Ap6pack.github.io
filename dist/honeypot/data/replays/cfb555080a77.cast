[0.69468,"o","\n"]
[0.694697,"o","Usage: busybox [function] [arguments]...\n"]
[0.694714,"o","   or: busybox --list[-full]\n"]
[0.694731,"o","   or: busybox --install [-s] [DIR]\n"]
[0.694749,"o","   or: function [arguments]...\n"]
[0.694766,"o","\n"]
[0.694783,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.694799,"o","    utilities into a single executable.  Most people will create a\n"]
[0.694816,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.694832,"o","    will act like whatever it was invoked as.\n"]
[0.694849,"o","\n"]
