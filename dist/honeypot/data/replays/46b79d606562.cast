[1.167717,"o","\n"]
[1.167733,"o","Usage: busybox [function] [arguments]...\n"]
[1.16775,"o","   or: busybox --list[-full]\n"]
[1.167766,"o","   or: busybox --install [-s] [DIR]\n"]
[1.167783,"o","   or: function [arguments]...\n"]
[1.167799,"o","\n"]
[1.167816,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.167849,"o","    utilities into a single executable.  Most people will create a\n"]
[1.167874,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.167893,"o","    will act like whatever it was invoked as.\n"]
