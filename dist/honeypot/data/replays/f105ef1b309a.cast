[1.344727,"o","\n"]
[1.344744,"o","Usage: busybox [function] [arguments]...\n"]
[1.344762,"o","   or: busybox --list[-full]\n"]
[1.34478,"o","   or: busybox --install [-s] [DIR]\n"]
[1.344796,"o","   or: function [arguments]...\n"]
[1.344813,"o","\n"]
[1.344831,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.344867,"o","    utilities into a single executable.  Most people will create a\n"]
[1.344885,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.344902,"o","    will act like whatever it was invoked as.\n"]
[1.344919,"o","\n"]
