[28.121965,"o","\u001b[4l"]
[28.122043,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[28.122092,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[28.122113,"o","and others. Licensed under GPLv2.\n"]
[28.122131,"o","See source distribution for full notice.\n"]
[28.12215,"o","\n"]
[28.122167,"o","Usage: busybox [function] [arguments]...\n"]
[28.122185,"o","   or: busybox --list[-full]\n"]
[28.122201,"o","   or: busybox --install [-s] [DIR]\n"]
[28.122218,"o","   or: function [arguments]...\n"]
[28.122235,"o","\n"]
[28.122252,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[28.122285,"o","    utilities into a single executable.  Most people will create a\n"]
[28.122303,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[28.12232,"o","    will act like whatever it was invoked as.\n"]
[28.122336,"o","\n"]
[28.122352,"o","Currently defined functions:\n"]
[28.12237,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[28.122387,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[28.122404,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[28.12242,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[28.122437,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[28.122453,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[28.12247,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[28.122488,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[28.122505,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[28.122522,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[28.122538,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[28.122554,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[28.122571,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[28.122587,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
