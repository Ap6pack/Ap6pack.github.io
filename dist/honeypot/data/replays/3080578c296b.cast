[0.539856,"o","\n"]
[0.539874,"o","Usage: busybox [function] [arguments]...\n"]
[0.539891,"o","   or: busybox --list[-full]\n"]
[0.539908,"o","   or: busybox --install [-s] [DIR]\n"]
[0.539927,"o","   or: function [arguments]...\n"]
[0.539945,"o","\n"]
[0.539963,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.539981,"o","    utilities into a single executable.  Most people will create a\n"]
[0.539999,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.540017,"o","    will act like whatever it was invoked as.\n"]
[0.540034,"o","\n"]
[0.540068,"o","Currently defined functions:\n"]
[0.540093,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.540111,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.540128,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.540146,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.540163,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.54018,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.540206,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.540228,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.540245,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.540262,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.540279,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.540296,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.540312,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.540329,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.540346,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.540363,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.540379,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.540396,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.540412,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.540428,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.540445,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.540461,"o","    zcat\n"]
