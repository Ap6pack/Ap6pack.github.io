[123.001156,"o","\n"]
[123.001174,"o","Usage: busybox [function] [arguments]...\n"]
[123.001194,"o","   or: busybox --list[-full]\n"]
[123.001212,"o","   or: busybox --install [-s] [DIR]\n"]
[123.001229,"o","   or: function [arguments]...\n"]
[123.001246,"o","\n"]
[123.001264,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[123.001282,"o","    utilities into a single executable.  Most people will create a\n"]
[123.001316,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[123.001334,"o","    will act like whatever it was invoked as.\n"]
[123.001352,"o","\n"]
[123.001369,"o","Currently defined functions:\n"]
[123.001387,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[123.001405,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[123.001422,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[123.001441,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
