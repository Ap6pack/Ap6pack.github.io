[114.184522,"o","   or: busybox --install [-s] [DIR]\n"]
[114.184539,"o","   or: function [arguments]...\n"]
[114.184555,"o","\n"]
[114.184572,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[114.18459,"o","    utilities into a single executable.  Most people will create a\n"]
[114.184607,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[114.184623,"o","    will act like whatever it was invoked as.\n"]
[114.184639,"o","\n"]
