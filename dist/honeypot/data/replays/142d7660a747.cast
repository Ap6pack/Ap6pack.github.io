[0.706004,"o","\n"]
[0.70612,"o","Usage: busybox [function] [arguments]...\n"]
[0.7062,"o","   or: busybox --list[-full]\n"]
[0.706304,"o","   or: busybox --install [-s] [DIR]\n"]
[0.706323,"o","   or: function [arguments]...\n"]
[0.70645,"o","\n"]
[0.706469,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.706487,"o","    utilities into a single executable.  Most people will create a\n"]
[0.706509,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.706526,"o","    will act like whatever it was invoked as.\n"]
[0.706543,"o","\n"]
[0.706562,"o","Currently defined functions:\n"]
[0.706579,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
