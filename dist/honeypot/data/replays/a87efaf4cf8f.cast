[75.738356,"o","\n"]
[75.738373,"o","Usage: busybox [function] [arguments]...\n"]
[75.73839,"o","   or: busybox --list[-full]\n"]
[75.738407,"o","   or: busybox --install [-s] [DIR]\n"]
[75.738424,"o","   or: function [arguments]...\n"]
[75.73844,"o","\n"]
[75.738458,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[75.738475,"o","    utilities into a single executable.  Most people will create a\n"]
[75.738492,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[75.738508,"o","    will act like whatever it was invoked as.\n"]
[75.738525,"o","\n"]
