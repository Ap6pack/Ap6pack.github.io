[2.81194,"o","\u001b[4l"]
[2.81202,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[2.812045,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[2.812064,"o","and others. Licensed under GPLv2.\n"]
[2.812082,"o","See source distribution for full notice.\n"]
[2.812099,"o","\n"]
[2.812116,"o","Usage: busybox [function] [arguments]...\n"]
[2.812133,"o","   or: busybox --list[-full]\n"]
[2.812171,"o","   or: busybox --install [-s] [DIR]\n"]
[2.812196,"o","   or: function [arguments]...\n"]
[2.812214,"o","\n"]
[2.812232,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[2.812265,"o","    utilities into a single executable.  Most people will create a\n"]
[2.812282,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[2.812299,"o","    will act like whatever it was invoked as.\n"]
[2.812317,"o","\n"]
[2.812334,"o","Currently defined functions:\n"]
[2.812351,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[2.812367,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[2.812384,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[2.812401,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[2.812417,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[2.812434,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[2.812451,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[2.812468,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[2.812485,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[2.812502,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[2.81252,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[2.812536,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[2.812555,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[2.812572,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[2.812589,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
