[1.187072,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.1871,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.18712,"o","and others. Licensed under GPLv2.\n"]
[1.18714,"o","See source distribution for full notice.\n"]
[1.187157,"o","\n"]
[1.187175,"o","Usage: busybox [function] [arguments]...\n"]
[1.187192,"o","   or: busybox --list[-full]\n"]
[1.18721,"o","   or: busybox --install [-s] [DIR]\n"]
[1.187227,"o","   or: function [arguments]...\n"]
[1.187245,"o","\n"]
[1.187263,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.187281,"o","    utilities into a single executable.  Most people will create a\n"]
[1.187317,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.187335,"o","    will act like whatever it was invoked as.\n"]
[1.187352,"o","\n"]
[1.187374,"o","Currently defined functions:\n"]
[1.187392,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.187429,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.187456,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.187474,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.187492,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.18751,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.187533,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.187563,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.187582,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.1876,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.187624,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.187643,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.187661,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.187678,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.187696,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.187713,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[1.18773,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[1.187747,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[1.187773,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[1.187792,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[1.187809,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[1.187826,"o","    zcat\n"]
