[4.205383,"o","\u001b[4l"]
[4.205487,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[4.205518,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[4.205539,"o","and others. Licensed under GPLv2.\n"]
[4.205557,"o","See source distribution for full notice.\n"]
[4.205574,"o","\n"]
[4.205591,"o","Usage: busybox [function] [arguments]...\n"]
[4.205608,"o","   or: busybox --list[-full]\n"]
[4.205625,"o","   or: busybox --install [-s] [DIR]\n"]
[4.205642,"o","   or: function [arguments]...\n"]
[4.205658,"o","\n"]
[4.205675,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.205692,"o","    utilities into a single executable.  Most people will create a\n"]
[4.205709,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.205725,"o","    will act like whatever it was invoked as.\n"]
[4.205741,"o","\n"]
[4.205759,"o","Currently defined functions:\n"]
[4.205775,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[4.205792,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[4.205808,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[4.205825,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[4.205844,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[4.205861,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[4.205879,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[4.205896,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[4.205915,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[4.205934,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[4.205951,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[4.205968,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[4.205985,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[4.206003,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[4.206021,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[4.206042,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[4.20606,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[4.206076,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[4.206093,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[4.206118,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[4.206147,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[4.206164,"o","    zcat\n"]
[4.206202,"o","\u001b[4h"]
[4.206269,"o","root@honeypot-01:/home# "]
