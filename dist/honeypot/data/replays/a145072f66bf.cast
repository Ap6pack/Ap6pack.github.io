[0.815523,"o","\n"]
[0.815539,"o","Usage: busybox [function] [arguments]...\n"]
[0.815557,"o","   or: busybox --list[-full]\n"]
[0.815576,"o","   or: busybox --install [-s] [DIR]\n"]
[0.815593,"o","   or: function [arguments]...\n"]
[0.81561,"o","\n"]
[0.815626,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.815643,"o","    utilities into a single executable.  Most people will create a\n"]
[0.815659,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.815675,"o","    will act like whatever it was invoked as.\n"]
[0.815692,"o","\n"]
