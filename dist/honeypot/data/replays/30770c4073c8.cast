[88.982824,"o","   or: busybox --install [-s] [DIR]\n"]
[88.982842,"o","   or: function [arguments]...\n"]
[88.982859,"o","\n"]
[88.982878,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.982896,"o","    utilities into a single executable.  Most people will create a\n"]
[88.982914,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.98293,"o","    will act like whatever it was invoked as.\n"]
[88.982947,"o","\n"]
[88.982963,"o","Currently defined functions:\n"]
[88.98298,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
