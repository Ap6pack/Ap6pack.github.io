[0.454828,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.454852,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.454871,"o","and others. Licensed under GPLv2.\n"]
[0.454907,"o","See source distribution for full notice.\n"]
[0.454925,"o","\n"]
[0.454942,"o","Usage: busybox [function] [arguments]...\n"]
[0.454959,"o","   or: busybox --list[-full]\n"]
[0.454976,"o","   or: busybox --install [-s] [DIR]\n"]
[0.454993,"o","   or: function [arguments]...\n"]
[0.455009,"o","\n"]
[0.455026,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.455043,"o","    utilities into a single executable.  Most people will create a\n"]
[0.455059,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.455075,"o","    will act like whatever it was invoked as.\n"]
[0.455092,"o","\n"]
[0.455108,"o","Currently defined functions:\n"]
[0.455126,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.455143,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.45516,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.455176,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.455192,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.455209,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.455225,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.455241,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.455258,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.455274,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.45529,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.455307,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.455323,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.45534,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.455356,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.455373,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.455389,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.455406,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.455422,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.455439,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.455456,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.455473,"o","    zcat\n"]
