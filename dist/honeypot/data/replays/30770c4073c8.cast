[112.328367,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[112.328392,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[112.328418,"o","and others. Licensed under GPLv2.\n"]
[112.328444,"o","See source distribution for full notice.\n"]
[112.328465,"o","\n"]
[112.328484,"o","Usage: busybox [function] [arguments]...\n"]
[112.328506,"o","   or: busybox --list[-full]\n"]
[112.328528,"o","   or: busybox --install [-s] [DIR]\n"]
[112.328555,"o","   or: function [arguments]...\n"]
[112.328616,"o","\n"]
[112.328651,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[112.328671,"o","    utilities into a single executable.  Most people will create a\n"]
[112.328695,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[112.328719,"o","    will act like whatever it was invoked as.\n"]
[112.328748,"o","\n"]
[112.328773,"o","Currently defined functions:\n"]
[112.328792,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[112.328814,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[112.328833,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[112.328851,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[112.328871,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[112.328889,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[112.328907,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[112.328925,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[112.328944,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[112.328962,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
