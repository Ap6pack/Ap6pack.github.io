[105.258391,"o","See source distribution for full notice.\n"]
[105.258408,"o","\n"]
[105.258425,"o","Usage: busybox [function] [arguments]...\n"]
[105.258442,"o","   or: busybox --list[-full]\n"]
[105.258458,"o","   or: busybox --install [-s] [DIR]\n"]
[105.258475,"o","   or: function [arguments]...\n"]
[105.25849,"o","\n"]
[105.258507,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[105.258524,"o","    utilities into a single executable.  Most people will create a\n"]
[105.25854,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[105.258556,"o","    will act like whatever it was invoked as.\n"]
[105.258573,"o","\n"]
[105.258614,"o","Currently defined functions:\n"]
[105.258633,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[105.258651,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[105.258667,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[105.258684,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[105.258701,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[105.258717,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[105.258733,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[105.25875,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[105.258767,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[105.258783,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
