[1.859405,"o","\u001b[4l"]
[1.859513,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.85954,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.85956,"o","and others. Licensed under GPLv2.\n"]
[1.859595,"o","See source distribution for full notice.\n"]
[1.859622,"o","\n"]
[1.859641,"o","Usage: busybox [function] [arguments]...\n"]
[1.859658,"o","   or: busybox --list[-full]\n"]
[1.859675,"o","   or: busybox --install [-s] [DIR]\n"]
[1.859693,"o","   or: function [arguments]...\n"]
[1.859709,"o","\n"]
[1.859727,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.85976,"o","    utilities into a single executable.  Most people will create a\n"]
[1.859777,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.859794,"o","    will act like whatever it was invoked as.\n"]
[1.859811,"o","\n"]
[1.859828,"o","Currently defined functions:\n"]
[1.859845,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.859862,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.859879,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.859896,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.859914,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.85993,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.859948,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.859965,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.859982,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.859999,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.860016,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.860033,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.860049,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.860067,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.860084,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
