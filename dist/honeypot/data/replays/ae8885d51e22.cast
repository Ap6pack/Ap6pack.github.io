[0.337841,"o","\n"]
[0.337859,"o","Usage: busybox [function] [arguments]...\n"]
[0.337876,"o","   or: busybox --list[-full]\n"]
[0.337893,"o","   or: busybox --install [-s] [DIR]\n"]
[0.337911,"o","   or: function [arguments]...\n"]
[0.337928,"o","\n"]
[0.337946,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.337963,"o","    utilities into a single executable.  Most people will create a\n"]
[0.33798,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.337997,"o","    will act like whatever it was invoked as.\n"]
[0.338015,"o","\n"]
[0.338032,"o","Currently defined functions:\n"]
[0.33805,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.338067,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.338087,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.338104,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.338123,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.338142,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.338163,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.338181,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.338199,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.338218,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.338238,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.33826,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.33828,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.3383,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.338319,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.338336,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.338356,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.338375,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.338393,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.338412,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.33843,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.338451,"o","    zcat\n"]
