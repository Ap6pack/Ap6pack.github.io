[1.649201,"o","\u001b[4l"]
[1.649298,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.649324,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.649344,"o","and others. Licensed under GPLv2.\n"]
[1.649364,"o","See source distribution for full notice.\n"]
[1.649382,"o","\n"]
[1.649399,"o","Usage: busybox [function] [arguments]...\n"]
[1.649419,"o","   or: busybox --list[-full]\n"]
[1.649438,"o","   or: busybox --install [-s] [DIR]\n"]
[1.649456,"o","   or: function [arguments]...\n"]
[1.649473,"o","\n"]
[1.649491,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.649523,"o","    utilities into a single executable.  Most people will create a\n"]
[1.649542,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.649576,"o","    will act like whatever it was invoked as.\n"]
[1.649602,"o","\n"]
[1.64962,"o","Currently defined functions:\n"]
[1.64964,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.649658,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.649678,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.649696,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.649717,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.649735,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.649753,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.649772,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.649791,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.64981,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.649829,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.649849,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.649868,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.649887,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.649906,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.649925,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[1.649944,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[1.649963,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
