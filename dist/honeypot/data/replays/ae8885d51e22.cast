[94.390979,"o","\n"]
[94.391008,"o","Usage: busybox [function] [arguments]...\n"]
[94.391028,"o","   or: busybox --list[-full]\n"]
[94.39105,"o","   or: busybox --install [-s] [DIR]\n"]
[94.391074,"o","   or: function [arguments]...\n"]
[94.391097,"o","\n"]
[94.391117,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[94.391138,"o","    utilities into a single executable.  Most people will create a\n"]
[94.39116,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[94.391181,"o","    will act like whatever it was invoked as.\n"]
[94.3912,"o","\n"]
[94.391222,"o","Currently defined functions:\n"]
[94.391244,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[94.391266,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[94.391286,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[94.391307,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[94.391328,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[94.391351,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[94.39139,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[94.391409,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
