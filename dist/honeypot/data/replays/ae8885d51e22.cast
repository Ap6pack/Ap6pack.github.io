[91.509902,"o","\n"]
[91.509922,"o","Usage: busybox [function] [arguments]...\n"]
[91.509943,"o","   or: busybox --list[-full]\n"]
[91.509964,"o","   or: busybox --install [-s] [DIR]\n"]
[91.509984,"o","   or: function [arguments]...\n"]
[91.510005,"o","\n"]
[91.510025,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[91.510045,"o","    utilities into a single executable.  Most people will create a\n"]
[91.510064,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[91.510083,"o","    will act like whatever it was invoked as.\n"]
[91.510103,"o","\n"]
[91.510121,"o","Currently defined functions:\n"]
[91.510139,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[91.510158,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[91.510175,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[91.510195,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[91.510213,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
