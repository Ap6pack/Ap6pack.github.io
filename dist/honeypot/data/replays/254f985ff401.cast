[101.158722,"o","\n"]
[101.158739,"o","Usage: busybox [function] [arguments]...\n"]
[101.158755,"o","   or: busybox --list[-full]\n"]
[101.158771,"o","   or: busybox --install [-s] [DIR]\n"]
[101.158787,"o","   or: function [arguments]...\n"]
[101.158803,"o","\n"]
[101.15882,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[101.158837,"o","    utilities into a single executable.  Most people will create a\n"]
[101.158853,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[101.158869,"o","    will act like whatever it was invoked as.\n"]
[101.158886,"o","\n"]
[101.158902,"o","Currently defined functions:\n"]
[101.158918,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[101.158935,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[101.158951,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[101.158968,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[101.158985,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[101.159001,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[101.15903,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[101.159047,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
