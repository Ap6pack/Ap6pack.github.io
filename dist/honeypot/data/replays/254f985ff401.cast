[84.373315,"o","\n"]
[84.373337,"o","Usage: busybox [function] [arguments]...\n"]
[84.373356,"o","   or: busybox --list[-full]\n"]
[84.373374,"o","   or: busybox --install [-s] [DIR]\n"]
[84.373391,"o","   or: function [arguments]...\n"]
[84.373426,"o","\n"]
[84.373446,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[84.373466,"o","    utilities into a single executable.  Most people will create a\n"]
[84.373485,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[84.373502,"o","    will act like whatever it was invoked as.\n"]
[84.37352,"o","\n"]
[84.373537,"o","Currently defined functions:\n"]
[84.373554,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[84.373572,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
