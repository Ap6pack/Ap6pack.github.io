[71.173415,"o","and others. Licensed under GPLv2.\n"]
[71.173435,"o","See source distribution for full notice.\n"]
[71.173452,"o","\n"]
[71.173469,"o","Usage: busybox [function] [arguments]...\n"]
[71.173493,"o","   or: busybox --list[-full]\n"]
[71.173511,"o","   or: busybox --install [-s] [DIR]\n"]
[71.173527,"o","   or: function [arguments]...\n"]
[71.173544,"o","\n"]
[71.173572,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[71.173591,"o","    utilities into a single executable.  Most people will create a\n"]
[71.173608,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[71.173644,"o","    will act like whatever it was invoked as.\n"]
[71.173662,"o","\n"]
[71.17368,"o","Currently defined functions:\n"]
[71.173697,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[71.173716,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[71.173733,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[71.173751,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[71.173768,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[71.173786,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[71.173809,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[71.173832,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
