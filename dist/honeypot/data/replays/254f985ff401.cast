[77.541467,"o","\n"]
[77.541484,"o","Usage: busybox [function] [arguments]...\n"]
[77.541501,"o","   or: busybox --list[-full]\n"]
[77.541518,"o","   or: busybox --install [-s] [DIR]\n"]
[77.541536,"o","   or: function [arguments]...\n"]
[77.541553,"o","\n"]
[77.54157,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[77.541588,"o","    utilities into a single executable.  Most people will create a\n"]
[77.541604,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[77.541621,"o","    will act like whatever it was invoked as.\n"]
[77.541638,"o","\n"]
[77.541654,"o","Currently defined functions:\n"]
[77.541671,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[77.541689,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[77.541707,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[77.541724,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[77.541741,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[77.541759,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[77.541778,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[77.541795,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
