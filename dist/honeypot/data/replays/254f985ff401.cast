[93.112925,"o","\n"]
[93.112943,"o","Usage: busybox [function] [arguments]...\n"]
[93.112961,"o","   or: busybox --list[-full]\n"]
[93.112977,"o","   or: busybox --install [-s] [DIR]\n"]
[93.112993,"o","   or: function [arguments]...\n"]
[93.113011,"o","\n"]
[93.113029,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[93.113046,"o","    utilities into a single executable.  Most people will create a\n"]
[93.113063,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[93.113079,"o","    will act like whatever it was invoked as.\n"]
[93.113096,"o","\n"]
[93.113112,"o","Currently defined functions:\n"]
[93.11313,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[93.113148,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[93.113165,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[93.113183,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
