[79.696917,"o","\n"]
[79.696934,"o","Usage: busybox [function] [arguments]...\n"]
[79.696951,"o","   or: busybox --list[-full]\n"]
[79.696968,"o","   or: busybox --install [-s] [DIR]\n"]
[79.696985,"o","   or: function [arguments]...\n"]
[79.697002,"o","\n"]
[79.697019,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[79.697037,"o","    utilities into a single executable.  Most people will create a\n"]
[79.697059,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[79.697077,"o","    will act like whatever it was invoked as.\n"]
[79.697094,"o","\n"]
[79.697119,"o","Currently defined functions:\n"]
[79.697138,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[79.697155,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[79.697178,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[79.6972,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[79.697232,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[79.697266,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[79.697286,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[79.697304,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
