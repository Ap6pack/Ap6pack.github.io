[0.352247,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.352282,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.352303,"o","and others. Licensed under GPLv2.\n"]
[0.35234,"o","See source distribution for full notice.\n"]
[0.352358,"o","\n"]
[0.352375,"o","Usage: busybox [function] [arguments]...\n"]
[0.352398,"o","   or: busybox --list[-full]\n"]
[0.352418,"o","   or: busybox --install [-s] [DIR]\n"]
[0.352435,"o","   or: function [arguments]...\n"]
[0.352452,"o","\n"]
[0.352468,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.352484,"o","    utilities into a single executable.  Most people will create a\n"]
[0.352501,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.352518,"o","    will act like whatever it was invoked as.\n"]
[0.352535,"o","\n"]
[0.352552,"o","Currently defined functions:\n"]
[0.352574,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.352601,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.352619,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.352637,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.352654,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.352671,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.352693,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.35271,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.352726,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.352743,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.352759,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.352779,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.352799,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.352816,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.352833,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.35285,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.352867,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.352883,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.3529,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.352916,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.352934,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.35295,"o","    zcat\n"]
