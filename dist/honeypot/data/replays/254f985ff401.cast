[1.458489,"o","\u001b[4l"]
[1.458566,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.458593,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.458612,"o","and others. Licensed under GPLv2.\n"]
[1.45863,"o","See source distribution for full notice.\n"]
[1.458647,"o","\n"]
[1.458665,"o","Usage: busybox [function] [arguments]...\n"]
[1.458682,"o","   or: busybox --list[-full]\n"]
[1.4587,"o","   or: busybox --install [-s] [DIR]\n"]
[1.458718,"o","   or: function [arguments]...\n"]
[1.458737,"o","\n"]
[1.458754,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.458794,"o","    utilities into a single executable.  Most people will create a\n"]
[1.458812,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.458828,"o","    will act like whatever it was invoked as.\n"]
[1.458845,"o","\n"]
[1.458862,"o","Currently defined functions:\n"]
[1.458879,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.458897,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.458916,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.458933,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.45895,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.458967,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.458987,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.459005,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.459023,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.45904,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.459057,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.459075,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.459094,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.45911,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
