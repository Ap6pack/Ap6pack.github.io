[42.100787,"o","\n"]
[42.100805,"o","Usage: busybox [function] [arguments]...\n"]
[42.100822,"o","   or: busybox --list[-full]\n"]
[42.100839,"o","   or: busybox --install [-s] [DIR]\n"]
[42.100856,"o","   or: function [arguments]...\n"]
[42.100873,"o","\n"]
[42.10089,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[42.100907,"o","    utilities into a single executable.  Most people will create a\n"]
[42.100924,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[42.100941,"o","    will act like whatever it was invoked as.\n"]
[42.100958,"o","\n"]
[42.100974,"o","Currently defined functions:\n"]
[42.100991,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[42.101008,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
