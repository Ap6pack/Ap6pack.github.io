[42.101058,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[42.101075,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[42.101091,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[42.101109,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
