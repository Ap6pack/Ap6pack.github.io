[5.078205,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[5.078228,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[5.078249,"o","and others. Licensed under GPLv2.\n"]
[5.078288,"o","See source distribution for full notice.\n"]
[5.078316,"o","\n"]
[5.078334,"o","Usage: busybox [function] [arguments]...\n"]
[5.078352,"o","   or: busybox --list[-full]\n"]
[5.078369,"o","   or: busybox --install [-s] [DIR]\n"]
[5.078386,"o","   or: function [arguments]...\n"]
[5.078403,"o","\n"]
[5.078421,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[5.078438,"o","    utilities into a single executable.  Most people will create a\n"]
[5.078455,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[5.078472,"o","    will act like whatever it was invoked as.\n"]
[5.078489,"o","\n"]
[5.078506,"o","Currently defined functions:\n"]
[5.078523,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[5.078541,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[5.078572,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[5.07859,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[5.078607,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[5.078624,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[5.078641,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[5.078659,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[5.078676,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[5.078693,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[5.07871,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[5.078726,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[5.078743,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[5.07876,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[5.078778,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[5.078794,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[5.078811,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[5.078828,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[5.078845,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[5.078861,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[5.078879,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[5.078895,"o","    zcat\n"]
