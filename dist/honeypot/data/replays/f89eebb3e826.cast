[1.15804,"o","\n"]
[1.158059,"o","Usage: busybox [function] [arguments]...\n"]
[1.158077,"o","   or: busybox --list[-full]\n"]
[1.158124,"o","   or: busybox --install [-s] [DIR]\n"]
[1.158145,"o","   or: function [arguments]...\n"]
[1.158166,"o","\n"]
[1.158193,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.158214,"o","    utilities into a single executable.  Most people will create a\n"]
[1.158231,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.158248,"o","    will act like whatever it was invoked as.\n"]
[1.158284,"o","\n"]
[1.15831,"o","Currently defined functions:\n"]
[1.158329,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.158348,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.158367,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.158384,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.158408,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.158426,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.158444,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.158462,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.15848,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.158506,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.158546,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.158569,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.158587,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.158605,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.158623,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.158641,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[1.158658,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[1.158674,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[1.158702,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[1.15872,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[1.158738,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[1.158755,"o","    zcat\n"]
