[88.732233,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[88.732251,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
