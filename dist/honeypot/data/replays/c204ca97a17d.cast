[93.014325,"o","\n"]
[93.014341,"o","Usage: busybox [function] [arguments]...\n"]
[93.014357,"o","   or: busybox --list[-full]\n"]
[93.014374,"o","   or: busybox --install [-s] [DIR]\n"]
[93.014391,"o","   or: function [arguments]...\n"]
[93.014407,"o","\n"]
[93.014423,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[93.01444,"o","    utilities into a single executable.  Most people will create a\n"]
[93.014456,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[93.014473,"o","    will act like whatever it was invoked as.\n"]
