[73.112619,"o","   or: busybox --install [-s] [DIR]\n"]
[73.112636,"o","   or: function [arguments]...\n"]
[73.112652,"o","\n"]
[73.112669,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[73.112703,"o","    utilities into a single executable.  Most people will create a\n"]
[73.11272,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[73.11277,"o","    will act like whatever it was invoked as.\n"]
[73.11279,"o","\n"]
