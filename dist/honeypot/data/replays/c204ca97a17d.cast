[77.699627,"o","\n"]
[77.699645,"o","Usage: busybox [function] [arguments]...\n"]
[77.699662,"o","   or: busybox --list[-full]\n"]
[77.69968,"o","   or: busybox --install [-s] [DIR]\n"]
[77.699698,"o","   or: function [arguments]...\n"]
[77.699715,"o","\n"]
[77.69976,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[77.699782,"o","    utilities into a single executable.  Most people will create a\n"]
[77.6998,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[77.699817,"o","    will act like whatever it was invoked as.\n"]
