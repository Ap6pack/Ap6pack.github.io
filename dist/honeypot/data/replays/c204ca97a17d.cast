[94.093229,"o","\n"]
[94.093246,"o","Usage: busybox [function] [arguments]...\n"]
[94.093263,"o","   or: busybox --list[-full]\n"]
[94.09328,"o","   or: busybox --install [-s] [DIR]\n"]
[94.093298,"o","   or: function [arguments]...\n"]
[94.093314,"o","\n"]
[94.093331,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[94.093348,"o","    utilities into a single executable.  Most people will create a\n"]
[94.093364,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[94.093381,"o","    will act like whatever it was invoked as.\n"]
[94.093398,"o","\n"]
[94.093414,"o","Currently defined functions:\n"]
[94.093431,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
