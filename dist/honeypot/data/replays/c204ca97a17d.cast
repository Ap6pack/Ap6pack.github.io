[98.0012,"o","\n"]
[98.001217,"o","Usage: busybox [function] [arguments]...\n"]
[98.001236,"o","   or: busybox --list[-full]\n"]
[98.001253,"o","   or: busybox --install [-s] [DIR]\n"]
[98.001269,"o","   or: function [arguments]...\n"]
[98.001286,"o","\n"]
[98.001302,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[98.001319,"o","    utilities into a single executable.  Most people will create a\n"]
[98.001335,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[98.001352,"o","    will act like whatever it was invoked as.\n"]
[98.001385,"o","\n"]
[98.001402,"o","Currently defined functions:\n"]
[98.001419,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[98.001436,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[98.001452,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[98.00147,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[98.001486,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[98.001503,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[98.001519,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[98.001537,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[98.001553,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
