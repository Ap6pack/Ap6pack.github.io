[85.923605,"o","\n"]
[85.923621,"o","Usage: busybox [function] [arguments]...\n"]
[85.923638,"o","   or: busybox --list[-full]\n"]
[85.923655,"o","   or: busybox --install [-s] [DIR]\n"]
[85.923672,"o","   or: function [arguments]...\n"]
[85.923688,"o","\n"]
[85.923706,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[85.923742,"o","    utilities into a single executable.  Most people will create a\n"]
[85.923784,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[85.923802,"o","    will act like whatever it was invoked as.\n"]
[85.92382,"o","\n"]
[85.923837,"o","Currently defined functions:\n"]
[85.923854,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[85.923872,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
