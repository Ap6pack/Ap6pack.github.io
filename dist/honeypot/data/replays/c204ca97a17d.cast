[101.065434,"o","\n"]
[101.065451,"o","Usage: busybox [function] [arguments]...\n"]
[101.065468,"o","   or: busybox --list[-full]\n"]
[101.065486,"o","   or: busybox --install [-s] [DIR]\n"]
[101.065503,"o","   or: function [arguments]...\n"]
[101.065519,"o","\n"]
[101.065535,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[101.065552,"o","    utilities into a single executable.  Most people will create a\n"]
[101.065568,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[101.065584,"o","    will act like whatever it was invoked as.\n"]
[101.065601,"o","\n"]
[101.065618,"o","Currently defined functions:\n"]
[101.065635,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[101.065651,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[101.065668,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[101.065685,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[101.065702,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[101.065718,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[101.065761,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[101.065781,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
