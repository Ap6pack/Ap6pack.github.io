[0.383847,"o","\n"]
[0.383875,"o","Usage: busybox [function] [arguments]...\n"]
[0.383909,"o","   or: busybox --list[-full]\n"]
[0.383942,"o","   or: busybox --install [-s] [DIR]\n"]
[0.38397,"o","   or: function [arguments]...\n"]
[0.383989,"o","\n"]
[0.384007,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.384025,"o","    utilities into a single executable.  Most people will create a\n"]
[0.384045,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.384063,"o","    will act like whatever it was invoked as.\n"]
[0.384081,"o","\n"]
[0.384098,"o","Currently defined functions:\n"]
[0.384124,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.384154,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.38418,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.384205,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.384223,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.384242,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.384259,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.384277,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.384294,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.384311,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.384328,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.384345,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
