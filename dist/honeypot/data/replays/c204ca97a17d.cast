[88.731977,"o","\n"]
[88.731994,"o","Usage: busybox [function] [arguments]...\n"]
[88.732011,"o","   or: busybox --list[-full]\n"]
[88.732028,"o","   or: busybox --install [-s] [DIR]\n"]
[88.732045,"o","   or: function [arguments]...\n"]
[88.732061,"o","\n"]
[88.73208,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.732096,"o","    utilities into a single executable.  Most people will create a\n"]
[88.732114,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.732131,"o","    will act like whatever it was invoked as.\n"]
[88.732148,"o","\n"]
[88.732165,"o","Currently defined functions:\n"]
[88.732182,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[88.7322,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
