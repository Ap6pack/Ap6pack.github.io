[2.295284,"o","\u001b[4l"]
[2.295361,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[2.295386,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[2.295404,"o","and others. Licensed under GPLv2.\n"]
[2.295422,"o","See source distribution for full notice.\n"]
[2.295439,"o","\n"]
[2.295455,"o","Usage: busybox [function] [arguments]...\n"]
[2.295472,"o","   or: busybox --list[-full]\n"]
[2.295488,"o","   or: busybox --install [-s] [DIR]\n"]
[2.295505,"o","   or: function [arguments]...\n"]
[2.295522,"o","\n"]
[2.295539,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[2.295572,"o","    utilities into a single executable.  Most people will create a\n"]
[2.295589,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[2.295606,"o","    will act like whatever it was invoked as.\n"]
[2.295622,"o","\n"]
[2.295639,"o","Currently defined functions:\n"]
[2.295655,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[2.295671,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[2.295688,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[2.295704,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[2.29572,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[2.295766,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[2.295787,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[2.295804,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[2.295821,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[2.295837,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[2.295854,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[2.29587,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[2.295887,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[2.295903,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
