[69.724147,"o","See source distribution for full notice.\n"]
[69.724164,"o","\n"]
[69.72418,"o","Usage: busybox [function] [arguments]...\n"]
[69.724197,"o","   or: busybox --list[-full]\n"]
[69.724214,"o","   or: busybox --install [-s] [DIR]\n"]
[69.724231,"o","   or: function [arguments]...\n"]
[69.724248,"o","\n"]
[69.724264,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[69.724281,"o","    utilities into a single executable.  Most people will create a\n"]
[69.724297,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[69.724314,"o","    will act like whatever it was invoked as.\n"]
[69.724331,"o","\n"]
[69.724347,"o","Currently defined functions:\n"]
[69.724364,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[69.724381,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[69.724398,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[69.724414,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[69.724431,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[69.724448,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[69.724464,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[69.724497,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[69.724515,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[69.724532,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
