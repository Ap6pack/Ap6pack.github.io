[79.593544,"o","\n"]
[79.593562,"o","Usage: busybox [function] [arguments]...\n"]
[79.59358,"o","   or: busybox --list[-full]\n"]
[79.593597,"o","   or: busybox --install [-s] [DIR]\n"]
[79.593616,"o","   or: function [arguments]...\n"]
[79.593632,"o","\n"]
[79.593649,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[79.593667,"o","    utilities into a single executable.  Most people will create a\n"]
[79.593684,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[79.593701,"o","    will act like whatever it was invoked as.\n"]
