[104.128326,"o","\n"]
[104.128343,"o","Usage: busybox [function] [arguments]...\n"]
[104.12836,"o","   or: busybox --list[-full]\n"]
[104.128376,"o","   or: busybox --install [-s] [DIR]\n"]
[104.128394,"o","   or: function [arguments]...\n"]
[104.12841,"o","\n"]
[104.128427,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[104.128444,"o","    utilities into a single executable.  Most people will create a\n"]
[104.128461,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[104.128478,"o","    will act like whatever it was invoked as.\n"]
[104.128495,"o","\n"]
