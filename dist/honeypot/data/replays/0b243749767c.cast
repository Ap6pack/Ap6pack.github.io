[104.675008,"o","\u001b[4l"]
[104.67513,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[104.675159,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[104.67518,"o","and others. Licensed under GPLv2.\n"]
[104.675198,"o","See source distribution for full notice.\n"]
[104.675217,"o","\n"]
[104.675235,"o","Usage: busybox [function] [arguments]...\n"]
[104.675253,"o","   or: busybox --list[-full]\n"]
[104.67527,"o","   or: busybox --install [-s] [DIR]\n"]
[104.675286,"o","   or: function [arguments]...\n"]
[104.675303,"o","\n"]
[104.67532,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[104.675337,"o","    utilities into a single executable.  Most people will create a\n"]
[104.675354,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[104.675371,"o","    will act like whatever it was invoked as.\n"]
[104.675388,"o","\n"]
[104.675405,"o","Currently defined functions:\n"]
[104.675421,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[104.675438,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[104.675456,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[104.675473,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[104.67549,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[104.675507,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[104.675525,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[104.675543,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[104.675561,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[104.67558,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[104.675598,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[104.675616,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[104.675633,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[104.67565,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[104.675667,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[104.675685,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[104.675702,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[104.67572,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[104.675738,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[104.675756,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[104.675775,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[104.675792,"o","    zcat\n"]
