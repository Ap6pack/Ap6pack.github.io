[102.848518,"o","\n"]
[102.851445,"o","\u001b[4l"]
[102.851534,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[102.851561,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[102.85158,"o","and others. Licensed under GPLv2.\n"]
[102.851598,"o","See source distribution for full notice.\n"]
[102.851615,"o","\n"]
[102.851632,"o","Usage: busybox [function] [arguments]...\n"]
[102.851649,"o","   or: busybox --list[-full]\n"]
[102.851673,"o","   or: busybox --install [-s] [DIR]\n"]
[102.851691,"o","   or: function [arguments]...\n"]
[102.851714,"o","\n"]
[102.851731,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[102.851748,"o","    utilities into a single executable.  Most people will create a\n"]
[102.851771,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[102.851796,"o","    will act like whatever it was invoked as.\n"]
[102.851814,"o","\n"]
[102.851831,"o","Currently defined functions:\n"]
[102.851847,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[102.851867,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[102.851888,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[102.851907,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[102.851925,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[102.851986,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[102.85201,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[102.852036,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[102.85206,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[102.852078,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[102.852096,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[102.852114,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[102.852131,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[102.852147,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[102.852165,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[102.852181,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[102.852203,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[102.85223,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[102.852259,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[102.852285,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[102.852304,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[102.852321,"o","    zcat\n"]
[102.852361,"o","\u001b[4h"]
[102.852419,"o","admin@ip-172-31-80-180:~$ "]
