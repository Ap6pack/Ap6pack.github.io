[88.408469,"o","\n"]
[88.408488,"o","Usage: busybox [function] [arguments]...\n"]
[88.408521,"o","   or: busybox --list[-full]\n"]
[88.408539,"o","   or: busybox --install [-s] [DIR]\n"]
[88.408556,"o","   or: function [arguments]...\n"]
[88.408573,"o","\n"]
[88.408591,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.408609,"o","    utilities into a single executable.  Most people will create a\n"]
[88.408627,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.408645,"o","    will act like whatever it was invoked as.\n"]
[88.408663,"o","\n"]
[88.40868,"o","Currently defined functions:\n"]
[88.408697,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
