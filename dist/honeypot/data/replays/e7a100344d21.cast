[88.009483,"o","\n"]
[88.009502,"o","Usage: busybox [function] [arguments]...\n"]
[88.009524,"o","   or: busybox --list[-full]\n"]
[88.009543,"o","   or: busybox --install [-s] [DIR]\n"]
[88.009561,"o","   or: function [arguments]...\n"]
[88.009578,"o","\n"]
[88.009595,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.009612,"o","    utilities into a single executable.  Most people will create a\n"]
[88.009629,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.009647,"o","    will act like whatever it was invoked as.\n"]
[88.009664,"o","\n"]
[88.009681,"o","Currently defined functions:\n"]
[88.009697,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
