[99.709813,"o","   or: busybox --install [-s] [DIR]\n"]
[99.709838,"o","   or: function [arguments]...\n"]
[99.709866,"o","\n"]
[99.709892,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
