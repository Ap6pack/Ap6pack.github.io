[98.795443,"o","\n"]
[98.79546,"o","Usage: busybox [function] [arguments]...\n"]
[98.795478,"o","   or: busybox --list[-full]\n"]
[98.795494,"o","   or: busybox --install [-s] [DIR]\n"]
[98.795511,"o","   or: function [arguments]...\n"]
[98.795528,"o","\n"]
[98.795555,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[98.795576,"o","    utilities into a single executable.  Most people will create a\n"]
[98.795594,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[98.79561,"o","    will act like whatever it was invoked as.\n"]
[98.795627,"o","\n"]
[98.795644,"o","Currently defined functions:\n"]
[98.795661,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
