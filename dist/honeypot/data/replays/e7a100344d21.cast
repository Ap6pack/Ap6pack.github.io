[0.305018,"o","\n"]
[0.305036,"o","Usage: busybox [function] [arguments]...\n"]
[0.305053,"o","   or: busybox --list[-full]\n"]
[0.30507,"o","   or: busybox --install [-s] [DIR]\n"]
[0.305087,"o","   or: function [arguments]...\n"]
[0.305103,"o","\n"]
[0.30512,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.305137,"o","    utilities into a single executable.  Most people will create a\n"]
[0.305154,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.305171,"o","    will act like whatever it was invoked as.\n"]
[0.305188,"o","\n"]
[0.305205,"o","Currently defined functions:\n"]
[0.305223,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.30524,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.305257,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.305274,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.305291,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.305308,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.305325,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.305343,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.305361,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.305378,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.305415,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.305444,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.305463,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.305481,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.3055,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.305516,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.305537,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.305556,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.305573,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.305592,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.30561,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.305629,"o","    zcat\n"]
