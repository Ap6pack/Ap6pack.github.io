[84.002466,"o","\n"]
[84.002484,"o","Usage: busybox [function] [arguments]...\n"]
[84.002501,"o","   or: busybox --list[-full]\n"]
[84.002517,"o","   or: busybox --install [-s] [DIR]\n"]
[84.002534,"o","   or: function [arguments]...\n"]
[84.00255,"o","\n"]
[84.002567,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[84.002584,"o","    utilities into a single executable.  Most people will create a\n"]
[84.0026,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[84.002617,"o","    will act like whatever it was invoked as.\n"]
[84.002634,"o","\n"]
[84.00265,"o","Currently defined functions:\n"]
[84.002667,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[84.002684,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
