[90.942456,"o","\n"]
[90.942475,"o","Usage: busybox [function] [arguments]...\n"]
[90.942492,"o","   or: busybox --list[-full]\n"]
[90.942508,"o","   or: busybox --install [-s] [DIR]\n"]
[90.942525,"o","   or: function [arguments]...\n"]
[90.942541,"o","\n"]
[90.942557,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[90.942574,"o","    utilities into a single executable.  Most people will create a\n"]
[90.942591,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[90.942607,"o","    will act like whatever it was invoked as.\n"]
[90.942624,"o","\n"]
