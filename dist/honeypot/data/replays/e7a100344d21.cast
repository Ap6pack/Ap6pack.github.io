[91.206227,"o","Usage: busybox [function] [arguments]...\n"]
[91.206244,"o","   or: busybox --list[-full]\n"]
[91.206261,"o","   or: busybox --install [-s] [DIR]\n"]
[91.206278,"o","   or: function [arguments]...\n"]
[91.206294,"o","\n"]
[91.206311,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[91.206343,"o","    utilities into a single executable.  Most people will create a\n"]
[91.20636,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[91.206377,"o","    will act like whatever it was invoked as.\n"]
[91.206417,"o","\n"]
