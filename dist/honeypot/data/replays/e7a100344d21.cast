[1.611655,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.611681,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.611701,"o","and others. Licensed under GPLv2.\n"]
[1.611718,"o","See source distribution for full notice.\n"]
[1.611735,"o","\n"]
[1.611752,"o","Usage: busybox [function] [arguments]...\n"]
[1.611769,"o","   or: busybox --list[-full]\n"]
[1.611785,"o","   or: busybox --install [-s] [DIR]\n"]
[1.611802,"o","   or: function [arguments]...\n"]
[1.611818,"o","\n"]
[1.611835,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.611867,"o","    utilities into a single executable.  Most people will create a\n"]
[1.611884,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.611901,"o","    will act like whatever it was invoked as.\n"]
[1.611917,"o","\n"]
[1.611934,"o","Currently defined functions:\n"]
[1.611951,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.611968,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.611984,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.612001,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.612017,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.612034,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.612052,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.612069,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.612087,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.612104,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.612122,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.612139,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.612156,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.612174,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.612191,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.612209,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
