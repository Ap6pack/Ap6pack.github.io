[112.486744,"o","\n"]
[112.486761,"o","Usage: busybox [function] [arguments]...\n"]
[112.486779,"o","   or: busybox --list[-full]\n"]
[112.486796,"o","   or: busybox --install [-s] [DIR]\n"]
[112.486813,"o","   or: function [arguments]...\n"]
[112.48683,"o","\n"]
[112.486846,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[112.486864,"o","    utilities into a single executable.  Most people will create a\n"]
[112.486882,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[112.4869,"o","    will act like whatever it was invoked as.\n"]
[112.486916,"o","\n"]
[112.486933,"o","Currently defined functions:\n"]
[112.486949,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[112.486967,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
