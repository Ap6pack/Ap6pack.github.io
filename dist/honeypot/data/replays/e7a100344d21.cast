[72.243892,"o","\n"]
[72.243911,"o","Usage: busybox [function] [arguments]...\n"]
[72.243927,"o","   or: busybox --list[-full]\n"]
[72.243943,"o","   or: busybox --install [-s] [DIR]\n"]
[72.24396,"o","   or: function [arguments]...\n"]
[72.243976,"o","\n"]
[72.243994,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[72.244011,"o","    utilities into a single executable.  Most people will create a\n"]
[72.244029,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[72.244046,"o","    will act like whatever it was invoked as.\n"]
[72.244063,"o","\n"]
[72.244079,"o","Currently defined functions:\n"]
[72.244096,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
