[85.748235,"o","\n"]
[85.748251,"o","Usage: busybox [function] [arguments]...\n"]
[85.748269,"o","   or: busybox --list[-full]\n"]
[85.748286,"o","   or: busybox --install [-s] [DIR]\n"]
[85.748303,"o","   or: function [arguments]...\n"]
[85.748319,"o","\n"]
[85.748335,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[85.748352,"o","    utilities into a single executable.  Most people will create a\n"]
[85.748369,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[85.748385,"o","    will act like whatever it was invoked as.\n"]
[85.748429,"o","\n"]
[85.748448,"o","Currently defined functions:\n"]
[85.748466,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[85.748483,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
