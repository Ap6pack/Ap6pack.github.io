[82.933748,"o","\n"]
[82.933765,"o","Usage: busybox [function] [arguments]...\n"]
[82.933782,"o","   or: busybox --list[-full]\n"]
[82.933799,"o","   or: busybox --install [-s] [DIR]\n"]
[82.933815,"o","   or: function [arguments]...\n"]
[82.933831,"o","\n"]
[82.933848,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[82.933865,"o","    utilities into a single executable.  Most people will create a\n"]
[82.933881,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[82.933898,"o","    will act like whatever it was invoked as.\n"]
[82.933914,"o","\n"]
[82.933931,"o","Currently defined functions:\n"]
[82.933948,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[82.933966,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[82.933984,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[82.934001,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[82.934017,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
