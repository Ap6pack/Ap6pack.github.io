[103.73601,"o","\n"]
[103.736027,"o","Usage: busybox [function] [arguments]...\n"]
[103.736043,"o","   or: busybox --list[-full]\n"]
[103.736059,"o","   or: busybox --install [-s] [DIR]\n"]
[103.736076,"o","   or: function [arguments]...\n"]
[103.736093,"o","\n"]
[103.73611,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[103.736126,"o","    utilities into a single executable.  Most people will create a\n"]
[103.736142,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[103.736159,"o","    will act like whatever it was invoked as.\n"]
[103.736175,"o","\n"]
[103.736192,"o","Currently defined functions:\n"]
[103.736209,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[103.736226,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[103.736244,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[103.736261,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
