[88.808669,"o","\n"]
[88.808687,"o","Usage: busybox [function] [arguments]...\n"]
[88.808703,"o","   or: busybox --list[-full]\n"]
[88.80872,"o","   or: busybox --install [-s] [DIR]\n"]
[88.808736,"o","   or: function [arguments]...\n"]
[88.808753,"o","\n"]
[88.80877,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.808786,"o","    utilities into a single executable.  Most people will create a\n"]
[88.808803,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.80882,"o","    will act like whatever it was invoked as.\n"]
