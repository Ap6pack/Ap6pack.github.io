[1.413473,"o","\n"]
[1.41349,"o","Usage: busybox [function] [arguments]...\n"]
[1.413508,"o","   or: busybox --list[-full]\n"]
[1.413525,"o","   or: busybox --install [-s] [DIR]\n"]
[1.413547,"o","   or: function [arguments]...\n"]
[1.413565,"o","\n"]
[1.413591,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.413609,"o","    utilities into a single executable.  Most people will create a\n"]
[1.413627,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.413647,"o","    will act like whatever it was invoked as.\n"]
[1.413664,"o","\n"]
