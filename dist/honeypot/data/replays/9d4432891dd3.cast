[4.467923,"o","\u001b[4l"]
[4.468016,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[4.46804,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[4.468059,"o","and others. Licensed under GPLv2.\n"]
[4.468077,"o","See source distribution for full notice.\n"]
[4.468095,"o","\n"]
[4.468113,"o","Usage: busybox [function] [arguments]...\n"]
[4.46813,"o","   or: busybox --list[-full]\n"]
[4.468147,"o","   or: busybox --install [-s] [DIR]\n"]
[4.468164,"o","   or: function [arguments]...\n"]
[4.46818,"o","\n"]
[4.468197,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.468214,"o","    utilities into a single executable.  Most people will create a\n"]
[4.46823,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.468247,"o","    will act like whatever it was invoked as.\n"]
[4.46827,"o","\n"]
[4.468287,"o","Currently defined functions:\n"]
[4.468304,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[4.468321,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[4.468339,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[4.468357,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[4.468374,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[4.468392,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[4.46841,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[4.468428,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[4.468446,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[4.468463,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[4.468481,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[4.468499,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[4.468517,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[4.468535,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[4.468552,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[4.468592,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[4.468615,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
