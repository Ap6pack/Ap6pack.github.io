[4.93809,"o","\n"]
[4.938113,"o","Usage: busybox [function] [arguments]...\n"]
[4.938135,"o","   or: busybox --list[-full]\n"]
[4.938157,"o","   or: busybox --install [-s] [DIR]\n"]
[4.938175,"o","   or: function [arguments]...\n"]
[4.938198,"o","\n"]
[4.938219,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[4.938241,"o","    utilities into a single executable.  Most people will create a\n"]
[4.938267,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[4.938289,"o","    will act like whatever it was invoked as.\n"]
[4.938309,"o","\n"]
