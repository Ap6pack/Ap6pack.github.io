[76.868518,"o","\n"]
[76.868535,"o","Usage: busybox [function] [arguments]...\n"]
[76.868552,"o","   or: busybox --list[-full]\n"]
[76.868569,"o","   or: busybox --install [-s] [DIR]\n"]
[76.868586,"o","   or: function [arguments]...\n"]
[76.868603,"o","\n"]
[76.868639,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[76.868669,"o","    utilities into a single executable.  Most people will create a\n"]
[76.868688,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[76.868706,"o","    will act like whatever it was invoked as.\n"]
[76.868724,"o","\n"]
[76.868741,"o","Currently defined functions:\n"]
[76.868758,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[76.868776,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
