[1.702988,"o","\u001b[4l"]
[1.703072,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.703096,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.703118,"o","and others. Licensed under GPLv2.\n"]
[1.703136,"o","See source distribution for full notice.\n"]
[1.703153,"o","\n"]
[1.703169,"o","Usage: busybox [function] [arguments]...\n"]
[1.703186,"o","   or: busybox --list[-full]\n"]
[1.703203,"o","   or: busybox --install [-s] [DIR]\n"]
[1.70322,"o","   or: function [arguments]...\n"]
[1.703237,"o","\n"]
[1.703254,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.703287,"o","    utilities into a single executable.  Most people will create a\n"]
[1.703305,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.703321,"o","    will act like whatever it was invoked as.\n"]
[1.703339,"o","\n"]
[1.703355,"o","Currently defined functions:\n"]
[1.703372,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.70339,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.703408,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.703425,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.703443,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.70346,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.703477,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.703495,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.703512,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.703529,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.703545,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.703562,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.703578,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.703595,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
