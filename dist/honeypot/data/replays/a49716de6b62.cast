[98.938193,"o","\n"]
[98.93821,"o","Usage: busybox [function] [arguments]...\n"]
[98.938227,"o","   or: busybox --list[-full]\n"]
[98.938244,"o","   or: busybox --install [-s] [DIR]\n"]
[98.938261,"o","   or: function [arguments]...\n"]
[98.938277,"o","\n"]
[98.938294,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[98.938311,"o","    utilities into a single executable.  Most people will create a\n"]
[98.938328,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[98.938346,"o","    will act like whatever it was invoked as.\n"]
[98.938363,"o","\n"]
[98.93838,"o","Currently defined functions:\n"]
[98.938397,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[98.938414,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[98.938432,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[98.938449,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[98.938466,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[98.938483,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[98.938501,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[98.938519,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
