[74.208534,"o","\n"]
[74.20855,"o","Usage: busybox [function] [arguments]...\n"]
[74.208567,"o","   or: busybox --list[-full]\n"]
[74.208592,"o","   or: busybox --install [-s] [DIR]\n"]
[74.208611,"o","   or: function [arguments]...\n"]
[74.208647,"o","\n"]
[74.208666,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[74.208683,"o","    utilities into a single executable.  Most people will create a\n"]
[74.208699,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[74.208715,"o","    will act like whatever it was invoked as.\n"]
[74.208732,"o","\n"]
[74.208749,"o","Currently defined functions:\n"]
[74.208765,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
