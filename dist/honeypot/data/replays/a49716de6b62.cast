[68.590759,"o","\n"]
[68.590778,"o","Usage: busybox [function] [arguments]...\n"]
[68.590797,"o","   or: busybox --list[-full]\n"]
[68.590814,"o","   or: busybox --install [-s] [DIR]\n"]
[68.590836,"o","   or: function [arguments]...\n"]
[68.590857,"o","\n"]
[68.590874,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[68.590897,"o","    utilities into a single executable.  Most people will create a\n"]
[68.590915,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[68.59094,"o","    will act like whatever it was invoked as.\n"]
[68.590969,"o","\n"]
[68.590987,"o","Currently defined functions:\n"]
[68.591004,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[68.591022,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[68.591043,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[68.591062,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[68.591085,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
