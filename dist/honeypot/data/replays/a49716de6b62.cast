[76.86881,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[76.868826,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
