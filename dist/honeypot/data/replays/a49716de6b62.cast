[104.589323,"o","\n"]
[104.58934,"o","Usage: busybox [function] [arguments]...\n"]
[104.589358,"o","   or: busybox --list[-full]\n"]
[104.589376,"o","   or: busybox --install [-s] [DIR]\n"]
[104.589394,"o","   or: function [arguments]...\n"]
[104.589411,"o","\n"]
[104.589428,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[104.589446,"o","    utilities into a single executable.  Most people will create a\n"]
[104.589463,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[104.589482,"o","    will act like whatever it was invoked as.\n"]
[104.589519,"o","\n"]
[104.589539,"o","Currently defined functions:\n"]
[104.589557,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
