[70.9996,"o","   or: busybox --install [-s] [DIR]\n"]
[70.999636,"o","   or: function [arguments]...\n"]
[70.999662,"o","\n"]
[70.999691,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[70.999719,"o","    utilities into a single executable.  Most people will create a\n"]
[70.999765,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[70.99979,"o","    will act like whatever it was invoked as.\n"]
[70.999809,"o","\n"]
[70.999835,"o","Currently defined functions:\n"]
[70.999864,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
