[76.868861,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[76.868879,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
