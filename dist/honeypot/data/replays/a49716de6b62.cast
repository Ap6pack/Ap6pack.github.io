[84.08543,"o","\n"]
[84.085447,"o","Usage: busybox [function] [arguments]...\n"]
[84.085464,"o","   or: busybox --list[-full]\n"]
[84.085481,"o","   or: busybox --install [-s] [DIR]\n"]
[84.085499,"o","   or: function [arguments]...\n"]
[84.085516,"o","\n"]
[84.085533,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[84.08555,"o","    utilities into a single executable.  Most people will create a\n"]
[84.085567,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[84.085584,"o","    will act like whatever it was invoked as.\n"]
[84.085601,"o","\n"]
[84.085639,"o","Currently defined functions:\n"]
[84.085665,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[84.085683,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
