[84.99943,"o","\n"]
[84.999447,"o","Usage: busybox [function] [arguments]...\n"]
[84.999464,"o","   or: busybox --list[-full]\n"]
[84.999481,"o","   or: busybox --install [-s] [DIR]\n"]
[84.999498,"o","   or: function [arguments]...\n"]
[84.999514,"o","\n"]
[84.999532,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[84.999548,"o","    utilities into a single executable.  Most people will create a\n"]
[84.999565,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[84.999582,"o","    will act like whatever it was invoked as.\n"]
