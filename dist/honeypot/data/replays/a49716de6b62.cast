[0.367279,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.367304,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.367328,"o","and others. Licensed under GPLv2.\n"]
[0.367369,"o","See source distribution for full notice.\n"]
[0.367387,"o","\n"]
[0.367404,"o","Usage: busybox [function] [arguments]...\n"]
[0.367422,"o","   or: busybox --list[-full]\n"]
[0.367439,"o","   or: busybox --install [-s] [DIR]\n"]
[0.367456,"o","   or: function [arguments]...\n"]
[0.367473,"o","\n"]
[0.36749,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.367507,"o","    utilities into a single executable.  Most people will create a\n"]
[0.367524,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.367541,"o","    will act like whatever it was invoked as.\n"]
[0.367558,"o","\n"]
[0.367575,"o","Currently defined functions:\n"]
[0.367592,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.36761,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.367655,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.367677,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.367696,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.367725,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.367744,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.367761,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.367779,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.367795,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.367811,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.367827,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.367843,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.367866,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.367888,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.367904,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.367921,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.367937,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.367954,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.36797,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.367988,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.368005,"o","    zcat\n"]
