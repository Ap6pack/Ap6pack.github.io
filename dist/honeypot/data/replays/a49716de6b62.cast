[106.485338,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[106.485359,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[106.485378,"o","and others. Licensed under GPLv2.\n"]
[106.485396,"o","See source distribution for full notice.\n"]
[106.485412,"o","\n"]
[106.485429,"o","Usage: busybox [function] [arguments]...\n"]
[106.485446,"o","   or: busybox --list[-full]\n"]
[106.485462,"o","   or: busybox --install [-s] [DIR]\n"]
[106.485479,"o","   or: function [arguments]...\n"]
[106.485496,"o","\n"]
[106.485512,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[106.485529,"o","    utilities into a single executable.  Most people will create a\n"]
[106.485546,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[106.485563,"o","    will act like whatever it was invoked as.\n"]
[106.48558,"o","\n"]
