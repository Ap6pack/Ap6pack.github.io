[0.716129,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.716155,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.716174,"o","and others. Licensed under GPLv2.\n"]
[0.716193,"o","See source distribution for full notice.\n"]
[0.716211,"o","\n"]
[0.716228,"o","Usage: busybox [function] [arguments]...\n"]
[0.716245,"o","   or: busybox --list[-full]\n"]
[0.716261,"o","   or: busybox --install [-s] [DIR]\n"]
[0.716278,"o","   or: function [arguments]...\n"]
[0.716294,"o","\n"]
[0.71631,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.716328,"o","    utilities into a single executable.  Most people will create a\n"]
[0.716364,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.716381,"o","    will act like whatever it was invoked as.\n"]
[0.716398,"o","\n"]
[0.716416,"o","Currently defined functions:\n"]
[0.716433,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.716451,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.716468,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.716484,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.716501,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.716518,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.716534,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.71655,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.716568,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.716585,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.716631,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.716654,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.716671,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.716688,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.716705,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.716724,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
