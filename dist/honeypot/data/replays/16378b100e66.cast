[6.303299,"o","\u001b[4l"]
[6.303374,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[6.303398,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[6.303417,"o","and others. Licensed under GPLv2.\n"]
[6.303434,"o","See source distribution for full notice.\n"]
[6.303451,"o","\n"]
[6.303467,"o","Usage: busybox [function] [arguments]...\n"]
[6.303485,"o","   or: busybox --list[-full]\n"]
[6.303502,"o","   or: busybox --install [-s] [DIR]\n"]
[6.303518,"o","   or: function [arguments]...\n"]
[6.303534,"o","\n"]
[6.303551,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[6.303582,"o","    utilities into a single executable.  Most people will create a\n"]
[6.303619,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[6.30364,"o","    will act like whatever it was invoked as.\n"]
[6.303657,"o","\n"]
[6.303674,"o","Currently defined functions:\n"]
[6.303691,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[6.303709,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[6.303725,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[6.303741,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[6.303758,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[6.303775,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[6.303792,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[6.303809,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[6.303826,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[6.303843,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[6.30386,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[6.303876,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[6.303893,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[6.30391,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[6.303928,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[6.303945,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[6.303962,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[6.303979,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[6.303995,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[6.304012,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[6.304028,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[6.304045,"o","    zcat\n"]
[6.304071,"o","\u001b[4h"]
[6.304124,"o","root@FICORA:/home# "]
