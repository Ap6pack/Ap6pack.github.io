[1.924338,"o","\u001b[4l"]
[1.924426,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.924452,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.924481,"o","and others. Licensed under GPLv2.\n"]
[1.92451,"o","See source distribution for full notice.\n"]
[1.924527,"o","\n"]
[1.924548,"o","Usage: busybox [function] [arguments]...\n"]
[1.924566,"o","   or: busybox --list[-full]\n"]
[1.924589,"o","   or: busybox --install [-s] [DIR]\n"]
[1.924611,"o","   or: function [arguments]...\n"]
[1.924629,"o","\n"]
[1.924646,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.924689,"o","    utilities into a single executable.  Most people will create a\n"]
[1.924707,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.924724,"o","    will act like whatever it was invoked as.\n"]
[1.92474,"o","\n"]
[1.924757,"o","Currently defined functions:\n"]
[1.924774,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.924791,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.924807,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.924824,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.92484,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.924857,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.924874,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.924891,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.924908,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.924926,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.924943,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.924959,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.924985,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.925004,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.925022,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
