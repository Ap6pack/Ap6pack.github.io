[71.902417,"o","\n"]
[71.902436,"o","Usage: busybox [function] [arguments]...\n"]
[71.902454,"o","   or: busybox --list[-full]\n"]
[71.902471,"o","   or: busybox --install [-s] [DIR]\n"]
[71.902488,"o","   or: function [arguments]...\n"]
[71.902504,"o","\n"]
[71.902521,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[71.902537,"o","    utilities into a single executable.  Most people will create a\n"]
[71.902554,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[71.902571,"o","    will act like whatever it was invoked as.\n"]
[71.902588,"o","\n"]
[71.902605,"o","Currently defined functions:\n"]
[71.902622,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[71.902641,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
