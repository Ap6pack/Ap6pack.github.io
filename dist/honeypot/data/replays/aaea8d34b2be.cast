[27.073575,"o","\u001b[4l"]
[27.073669,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[27.073694,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[27.073713,"o","and others. Licensed under GPLv2.\n"]
[27.073732,"o","See source distribution for full notice.\n"]
[27.073755,"o","\n"]
[27.073774,"o","Usage: busybox [function] [arguments]...\n"]
[27.073791,"o","   or: busybox --list[-full]\n"]
[27.073808,"o","   or: busybox --install [-s] [DIR]\n"]
[27.073825,"o","   or: function [arguments]...\n"]
[27.073841,"o","\n"]
[27.073858,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[27.073875,"o","    utilities into a single executable.  Most people will create a\n"]
[27.073892,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[27.073915,"o","    will act like whatever it was invoked as.\n"]
[27.073939,"o","\n"]
[27.073958,"o","Currently defined functions:\n"]
[27.073975,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[27.073993,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[27.074027,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[27.074053,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[27.074071,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[27.074088,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[27.074105,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[27.074122,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[27.074161,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[27.074184,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[27.074202,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[27.074219,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[27.074235,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[27.074252,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[27.074268,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[27.074285,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[27.074302,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[27.074318,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[27.074334,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[27.074351,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[27.074367,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[27.074384,"o","    zcat\n"]
[27.074414,"o","\u001b[4h"]
[27.074474,"o","root@slur:/home# "]
