[28.858532,"o","\u001b[4l"]
[28.858639,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[28.858664,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[28.858693,"o","and others. Licensed under GPLv2.\n"]
[28.85873,"o","See source distribution for full notice.\n"]
[28.858756,"o","\n"]
[28.858774,"o","Usage: busybox [function] [arguments]...\n"]
[28.858796,"o","   or: busybox --list[-full]\n"]
[28.858814,"o","   or: busybox --install [-s] [DIR]\n"]
[28.858831,"o","   or: function [arguments]...\n"]
[28.858848,"o","\n"]
[28.858865,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[28.858882,"o","    utilities into a single executable.  Most people will create a\n"]
[28.858898,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[28.858915,"o","    will act like whatever it was invoked as.\n"]
[28.858932,"o","\n"]
[28.858949,"o","Currently defined functions:\n"]
[28.85898,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[28.858999,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[28.859034,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[28.859061,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[28.859079,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[28.859096,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[28.859118,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[28.859139,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[28.859164,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[28.859183,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[28.859201,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[28.859218,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[28.859238,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[28.859257,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[28.859275,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[28.859292,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[28.85931,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[28.859326,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[28.859343,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[28.859359,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[28.859377,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[28.859393,"o","    zcat\n"]
[28.859424,"o","\u001b[4h"]
