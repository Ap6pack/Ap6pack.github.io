[1.159889,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.159912,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.159931,"o","and others. Licensed under GPLv2.\n"]
[1.159949,"o","See source distribution for full notice.\n"]
[1.159966,"o","\n"]
[1.159983,"o","Usage: busybox [function] [arguments]...\n"]
[1.16,"o","   or: busybox --list[-full]\n"]
[1.160037,"o","   or: busybox --install [-s] [DIR]\n"]
[1.160058,"o","   or: function [arguments]...\n"]
[1.160075,"o","\n"]
[1.160092,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.160109,"o","    utilities into a single executable.  Most people will create a\n"]
[1.160143,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.16016,"o","    will act like whatever it was invoked as.\n"]
[1.160177,"o","\n"]
[1.160193,"o","Currently defined functions:\n"]
[1.16021,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.160228,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.160245,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.160261,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.160278,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.160294,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.16031,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.160327,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.160344,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.16036,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.160376,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.160393,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.160409,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.160425,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.160442,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.160459,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[1.160475,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[1.160492,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[1.160509,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[1.160526,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[1.160543,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[1.16056,"o","    zcat\n"]
