[105.147695,"o","\u001b[4l"]
[105.147812,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[105.147839,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[105.147859,"o","and others. Licensed under GPLv2.\n"]
[105.147878,"o","See source distribution for full notice.\n"]
[105.147895,"o","\n"]
[105.147913,"o","Usage: busybox [function] [arguments]...\n"]
[105.14793,"o","   or: busybox --list[-full]\n"]
[105.14798,"o","   or: busybox --install [-s] [DIR]\n"]
[105.148006,"o","   or: function [arguments]...\n"]
[105.148023,"o","\n"]
[105.14804,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[105.148058,"o","    utilities into a single executable.  Most people will create a\n"]
[105.148075,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[105.148092,"o","    will act like whatever it was invoked as.\n"]
[105.148109,"o","\n"]
[105.148125,"o","Currently defined functions:\n"]
[105.148142,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[105.148159,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[105.148176,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[105.148193,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[105.14821,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[105.148227,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[105.148244,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[105.14826,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[105.148278,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[105.148294,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[105.148311,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[105.148327,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[105.148344,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[105.148361,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[105.148377,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[105.148394,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[105.148411,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[105.148428,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[105.148445,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[105.148462,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[105.148479,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[105.148496,"o","    zcat\n"]
