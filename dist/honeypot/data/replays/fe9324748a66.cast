[51.048455,"o","\u001b[4l"]
[51.048528,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[51.048554,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[51.048574,"o","and others. Licensed under GPLv2.\n"]
[51.048591,"o","See source distribution for full notice.\n"]
[51.048608,"o","\n"]
[51.048624,"o","Usage: busybox [function] [arguments]...\n"]
[51.048641,"o","   or: busybox --list[-full]\n"]
[51.048658,"o","   or: busybox --install [-s] [DIR]\n"]
[51.048675,"o","   or: function [arguments]...\n"]
[51.048692,"o","\n"]
[51.048708,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[51.048725,"o","    utilities into a single executable.  Most people will create a\n"]
[51.048742,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[51.048758,"o","    will act like whatever it was invoked as.\n"]
[51.048791,"o","\n"]
[51.048809,"o","Currently defined functions:\n"]
[51.048826,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[51.048843,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[51.04886,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[51.048877,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[51.048894,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[51.04891,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[51.048928,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[51.048965,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[51.048987,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[51.049004,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[51.049021,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[51.049038,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[51.049055,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[51.049073,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[51.049098,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
