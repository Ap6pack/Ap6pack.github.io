[2.432705,"o","\u001b[4l"]
[2.432831,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[2.432859,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[2.432879,"o","and others. Licensed under GPLv2.\n"]
[2.432897,"o","See source distribution for full notice.\n"]
[2.432915,"o","\n"]
[2.432934,"o","Usage: busybox [function] [arguments]...\n"]
[2.432977,"o","   or: busybox --list[-full]\n"]
[2.433016,"o","   or: busybox --install [-s] [DIR]\n"]
[2.433034,"o","   or: function [arguments]...\n"]
[2.433051,"o","\n"]
[2.433069,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[2.433086,"o","    utilities into a single executable.  Most people will create a\n"]
[2.433117,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[2.433134,"o","    will act like whatever it was invoked as.\n"]
[2.433151,"o","\n"]
[2.433169,"o","Currently defined functions:\n"]
[2.433186,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[2.433203,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[2.43322,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[2.43324,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[2.433258,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[2.433275,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[2.433291,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[2.433309,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[2.433325,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[2.433342,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[2.433359,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[2.433376,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[2.433392,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[2.433409,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[2.433426,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[2.433443,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[2.433459,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[2.433477,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[2.433493,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[2.43351,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[2.433527,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[2.433543,"o","    zcat\n"]
