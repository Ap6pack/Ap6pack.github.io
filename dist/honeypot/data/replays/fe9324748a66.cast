[72.662118,"o","\n"]
[72.662137,"o","Usage: busybox [function] [arguments]...\n"]
[72.662156,"o","   or: busybox --list[-full]\n"]
[72.662175,"o","   or: busybox --install [-s] [DIR]\n"]
[72.662193,"o","   or: function [arguments]...\n"]
[72.662212,"o","\n"]
[72.66223,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[72.662249,"o","    utilities into a single executable.  Most people will create a\n"]
[72.662268,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[72.662286,"o","    will act like whatever it was invoked as.\n"]
[72.662304,"o","\n"]
