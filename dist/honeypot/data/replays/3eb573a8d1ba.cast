[70.244154,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[70.244174,"o","and others. Licensed under GPLv2.\n"]
[70.244191,"o","See source distribution for full notice.\n"]
[70.244209,"o","\n"]
[70.244227,"o","Usage: busybox [function] [arguments]...\n"]
[70.244245,"o","   or: busybox --list[-full]\n"]
[70.244261,"o","   or: busybox --install [-s] [DIR]\n"]
[70.244278,"o","   or: function [arguments]...\n"]
[70.244294,"o","\n"]
[70.244311,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[70.244328,"o","    utilities into a single executable.  Most people will create a\n"]
[70.244345,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[70.244388,"o","    will act like whatever it was invoked as.\n"]
[70.244406,"o","\n"]
[70.244422,"o","Currently defined functions:\n"]
[70.24444,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[70.244457,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[70.244474,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[70.244491,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[70.244508,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[70.244526,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[70.244546,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[70.244585,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[70.244603,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[70.244622,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
