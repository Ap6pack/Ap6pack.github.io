[1.873415,"o","\u001b[4l"]
[1.873511,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.873536,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.873556,"o","and others. Licensed under GPLv2.\n"]
[1.873574,"o","See source distribution for full notice.\n"]
[1.873592,"o","\n"]
[1.873609,"o","Usage: busybox [function] [arguments]...\n"]
[1.873627,"o","   or: busybox --list[-full]\n"]
[1.873644,"o","   or: busybox --install [-s] [DIR]\n"]
[1.873661,"o","   or: function [arguments]...\n"]
[1.873677,"o","\n"]
[1.873694,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.873732,"o","    utilities into a single executable.  Most people will create a\n"]
[1.873749,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.873766,"o","    will act like whatever it was invoked as.\n"]
[1.873783,"o","\n"]
[1.8738,"o","Currently defined functions:\n"]
[1.873818,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.873835,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.873852,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.873868,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.873885,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.873904,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.873922,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.873939,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.873956,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.873974,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.873991,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.874009,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
