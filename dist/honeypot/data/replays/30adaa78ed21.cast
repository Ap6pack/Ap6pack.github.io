[94.552295,"o","\n"]
[94.552314,"o","Usage: busybox [function] [arguments]...\n"]
[94.552332,"o","   or: busybox --list[-full]\n"]
[94.552349,"o","   or: busybox --install [-s] [DIR]\n"]
[94.552365,"o","   or: function [arguments]...\n"]
[94.552382,"o","\n"]
[94.552399,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[94.552417,"o","    utilities into a single executable.  Most people will create a\n"]
[94.552433,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[94.55245,"o","    will act like whatever it was invoked as.\n"]
