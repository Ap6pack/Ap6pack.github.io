[0.327882,"o","\n"]
[0.327899,"o","Usage: busybox [function] [arguments]...\n"]
[0.327916,"o","   or: busybox --list[-full]\n"]
[0.327934,"o","   or: busybox --install [-s] [DIR]\n"]
[0.327951,"o","   or: function [arguments]...\n"]
[0.327968,"o","\n"]
[0.327984,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.328001,"o","    utilities into a single executable.  Most people will create a\n"]
[0.328036,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.328062,"o","    will act like whatever it was invoked as.\n"]
[0.328082,"o","\n"]
[0.328099,"o","Currently defined functions:\n"]
[0.328118,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.328135,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.328152,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.328168,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.328185,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.328203,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.32822,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.328239,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.328256,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.328274,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.328291,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.328309,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.328327,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.328345,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.328363,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.328381,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.328398,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.328415,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.328432,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.32845,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.328469,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.328486,"o","    zcat\n"]
