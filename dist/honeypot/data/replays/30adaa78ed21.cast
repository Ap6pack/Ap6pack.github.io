[89.657673,"o","\n"]
[89.65769,"o","Usage: busybox [function] [arguments]...\n"]
[89.657707,"o","   or: busybox --list[-full]\n"]
[89.657724,"o","   or: busybox --install [-s] [DIR]\n"]
[89.657741,"o","   or: function [arguments]...\n"]
[89.657758,"o","\n"]
[89.657775,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[89.657792,"o","    utilities into a single executable.  Most people will create a\n"]
[89.657809,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[89.657827,"o","    will act like whatever it was invoked as.\n"]
[89.657845,"o","\n"]
