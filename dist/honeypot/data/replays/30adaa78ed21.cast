[70.806551,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[70.806581,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[70.8066,"o","and others. Licensed under GPLv2.\n"]
[70.806618,"o","See source distribution for full notice.\n"]
[70.806637,"o","\n"]
[70.80666,"o","Usage: busybox [function] [arguments]...\n"]
[70.806679,"o","   or: busybox --list[-full]\n"]
[70.806696,"o","   or: busybox --install [-s] [DIR]\n"]
[70.806713,"o","   or: function [arguments]...\n"]
[70.80673,"o","\n"]
[70.806747,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[70.806766,"o","    utilities into a single executable.  Most people will create a\n"]
[70.806782,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[70.806799,"o","    will act like whatever it was invoked as.\n"]
[70.806816,"o","\n"]
[70.806833,"o","Currently defined functions:\n"]
[70.806849,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[70.806866,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[70.806884,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[70.8069,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[70.806918,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[70.806936,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[70.806953,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[70.806972,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[70.80699,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[70.807009,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[70.807066,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[70.807088,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[70.807107,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
