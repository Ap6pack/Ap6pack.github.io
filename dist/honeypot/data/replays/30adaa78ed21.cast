[67.445777,"o","\n"]
[67.445795,"o","Usage: busybox [function] [arguments]...\n"]
[67.445819,"o","   or: busybox --list[-full]\n"]
[67.44584,"o","   or: busybox --install [-s] [DIR]\n"]
[67.445882,"o","   or: function [arguments]...\n"]
[67.445901,"o","\n"]
[67.445919,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[67.445945,"o","    utilities into a single executable.  Most people will create a\n"]
[67.445968,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[67.445986,"o","    will act like whatever it was invoked as.\n"]
[67.446006,"o","\n"]
[67.446056,"o","Currently defined functions:\n"]
[67.446082,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[67.446102,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[67.44612,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[67.446138,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[67.446156,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
