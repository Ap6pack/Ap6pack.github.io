[22.795009,"o","\u001b[4l"]
[22.795095,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[22.795122,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[22.795143,"o","and others. Licensed under GPLv2.\n"]
[22.795163,"o","See source distribution for full notice.\n"]
[22.795182,"o","\n"]
[22.7952,"o","Usage: busybox [function] [arguments]...\n"]
[22.795219,"o","   or: busybox --list[-full]\n"]
[22.795237,"o","   or: busybox --install [-s] [DIR]\n"]
[22.795256,"o","   or: function [arguments]...\n"]
[22.795274,"o","\n"]
[22.795293,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[22.795311,"o","    utilities into a single executable.  Most people will create a\n"]
[22.795329,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[22.795347,"o","    will act like whatever it was invoked as.\n"]
[22.795366,"o","\n"]
[22.795384,"o","Currently defined functions:\n"]
[22.795403,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[22.795421,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[22.79544,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[22.795458,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[22.795493,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[22.795511,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[22.79553,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[22.795548,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[22.795566,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[22.795584,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[22.795601,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[22.795618,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[22.795636,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
