[91.218093,"o","\n"]
[91.218111,"o","Usage: busybox [function] [arguments]...\n"]
[91.218129,"o","   or: busybox --list[-full]\n"]
[91.218146,"o","   or: busybox --install [-s] [DIR]\n"]
[91.218163,"o","   or: function [arguments]...\n"]
[91.218181,"o","\n"]
[91.218198,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[91.218215,"o","    utilities into a single executable.  Most people will create a\n"]
[91.218233,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[91.21825,"o","    will act like whatever it was invoked as.\n"]
[91.218267,"o","\n"]
[91.218285,"o","Currently defined functions:\n"]
[91.218303,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[91.218323,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
