[67.446195,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[67.446214,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
