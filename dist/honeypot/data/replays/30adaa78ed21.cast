[80.987917,"o","\n"]
[80.98794,"o","Usage: busybox [function] [arguments]...\n"]
[80.987959,"o","   or: busybox --list[-full]\n"]
[80.987976,"o","   or: busybox --install [-s] [DIR]\n"]
[80.987994,"o","   or: function [arguments]...\n"]
[80.988012,"o","\n"]
[80.988071,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[80.988094,"o","    utilities into a single executable.  Most people will create a\n"]
[80.988113,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[80.988131,"o","    will act like whatever it was invoked as.\n"]
[80.988166,"o","\n"]
[80.988186,"o","Currently defined functions:\n"]
[80.988203,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[80.988221,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[80.98824,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[80.988258,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[80.988276,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[80.988296,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[80.988314,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[80.988332,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[80.988351,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[80.988371,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[80.988388,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
