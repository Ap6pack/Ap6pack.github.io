[99.578613,"o","\n"]
[99.578629,"o","Usage: busybox [function] [arguments]...\n"]
[99.578646,"o","   or: busybox --list[-full]\n"]
[99.578663,"o","   or: busybox --install [-s] [DIR]\n"]
[99.57868,"o","   or: function [arguments]...\n"]
[99.578697,"o","\n"]
[99.578714,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[99.578731,"o","    utilities into a single executable.  Most people will create a\n"]
[99.578749,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[99.578765,"o","    will act like whatever it was invoked as.\n"]
[99.578782,"o","\n"]
[99.578799,"o","Currently defined functions:\n"]
[99.578819,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[99.578837,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[99.578854,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[99.57887,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[99.578887,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[99.578905,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[99.578923,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[99.578942,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[99.578963,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[99.578983,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
