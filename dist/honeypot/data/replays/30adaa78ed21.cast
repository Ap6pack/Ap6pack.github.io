[2.580437,"o","\u001b[4l"]
[2.580557,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[2.58059,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[2.580615,"o","and others. Licensed under GPLv2.\n"]
[2.580638,"o","See source distribution for full notice.\n"]
[2.580658,"o","\n"]
[2.580677,"o","Usage: busybox [function] [arguments]...\n"]
[2.580696,"o","   or: busybox --list[-full]\n"]
[2.580714,"o","   or: busybox --install [-s] [DIR]\n"]
[2.580734,"o","   or: function [arguments]...\n"]
[2.580751,"o","\n"]
[2.580769,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[2.580822,"o","    utilities into a single executable.  Most people will create a\n"]
[2.580846,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[2.580865,"o","    will act like whatever it was invoked as.\n"]
[2.580882,"o","\n"]
[2.580899,"o","Currently defined functions:\n"]
[2.580917,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[2.580934,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[2.580951,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[2.580969,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[2.580986,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[2.581006,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[2.581048,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[2.581075,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[2.581095,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[2.581115,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[2.581135,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[2.581155,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[2.581174,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[2.581192,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[2.581211,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
