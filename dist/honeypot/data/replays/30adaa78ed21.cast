[96.29516,"o","\n"]
[96.295177,"o","Usage: busybox [function] [arguments]...\n"]
[96.295194,"o","   or: busybox --list[-full]\n"]
[96.295211,"o","   or: busybox --install [-s] [DIR]\n"]
[96.295228,"o","   or: function [arguments]...\n"]
[96.295245,"o","\n"]
[96.295261,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[96.295278,"o","    utilities into a single executable.  Most people will create a\n"]
[96.295295,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[96.295312,"o","    will act like whatever it was invoked as.\n"]
[96.295328,"o","\n"]
[96.295345,"o","Currently defined functions:\n"]
[96.295361,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[96.295378,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[96.295395,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[96.295412,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[96.295428,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
