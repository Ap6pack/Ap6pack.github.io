[1.935611,"o","\u001b[4l"]
[1.935692,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.935716,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.935736,"o","and others. Licensed under GPLv2.\n"]
[1.935755,"o","See source distribution for full notice.\n"]
[1.935793,"o","\n"]
[1.935812,"o","Usage: busybox [function] [arguments]...\n"]
[1.93583,"o","   or: busybox --list[-full]\n"]
[1.935847,"o","   or: busybox --install [-s] [DIR]\n"]
[1.935864,"o","   or: function [arguments]...\n"]
[1.935881,"o","\n"]
[1.935898,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.935928,"o","    utilities into a single executable.  Most people will create a\n"]
[1.935946,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.935963,"o","    will act like whatever it was invoked as.\n"]
[1.935979,"o","\n"]
[1.935996,"o","Currently defined functions:\n"]
[1.936013,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.93603,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.936046,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.936062,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.936078,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.936095,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.936111,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.936129,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.936148,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.936167,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.936184,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.936202,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.93622,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.936237,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.936255,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[1.936273,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
