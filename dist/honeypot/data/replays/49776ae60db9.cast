[0.388704,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.388729,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.388751,"o","and others. Licensed under GPLv2.\n"]
[0.388822,"o","See source distribution for full notice.\n"]
[0.388845,"o","\n"]
[0.388863,"o","Usage: busybox [function] [arguments]...\n"]
[0.388881,"o","   or: busybox --list[-full]\n"]
[0.3889,"o","   or: busybox --install [-s] [DIR]\n"]
[0.388918,"o","   or: function [arguments]...\n"]
[0.388936,"o","\n"]
[0.388954,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.388973,"o","    utilities into a single executable.  Most people will create a\n"]
[0.38899,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.389009,"o","    will act like whatever it was invoked as.\n"]
[0.389028,"o","\n"]
[0.389045,"o","Currently defined functions:\n"]
[0.389065,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.389085,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.389103,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.38912,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.389137,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.389154,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.389171,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.389191,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.38921,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.389229,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.389248,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.389266,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.389285,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.389305,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.389323,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.38934,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.389358,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.389376,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.389392,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.38941,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.389429,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.389448,"o","    zcat\n"]
