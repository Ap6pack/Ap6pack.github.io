[0.86674,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[0.866766,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[0.866788,"o","and others. Licensed under GPLv2.\n"]
[0.866808,"o","See source distribution for full notice.\n"]
[0.866825,"o","\n"]
[0.866842,"o","Usage: busybox [function] [arguments]...\n"]
[0.86686,"o","   or: busybox --list[-full]\n"]
[0.866895,"o","   or: busybox --install [-s] [DIR]\n"]
[0.866913,"o","   or: function [arguments]...\n"]
[0.866929,"o","\n"]
[0.866946,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.866963,"o","    utilities into a single executable.  Most people will create a\n"]
[0.866979,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.866996,"o","    will act like whatever it was invoked as.\n"]
[0.867013,"o","\n"]
[0.867029,"o","Currently defined functions:\n"]
[0.867046,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.867062,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.867078,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.867095,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.867112,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.867128,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.867145,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.867162,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.867179,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.867196,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.867213,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.86723,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.867247,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.867264,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.867281,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.867298,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.867315,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.867332,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.867349,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.867366,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.867383,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.8674,"o","    zcat\n"]
