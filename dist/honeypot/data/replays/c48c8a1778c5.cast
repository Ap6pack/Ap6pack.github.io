[1.652258,"o","\u001b[4l"]
[1.65235,"o","BusyBox v1.20.2 (Debian 1:1.20.0-7) multi-call binary.\n"]
[1.652376,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[1.652396,"o","and others. Licensed under GPLv2.\n"]
[1.652422,"o","See source distribution for full notice.\n"]
[1.652451,"o","\n"]
[1.652477,"o","Usage: busybox [function] [arguments]...\n"]
[1.6525,"o","   or: busybox --list[-full]\n"]
[1.652523,"o","   or: busybox --install [-s] [DIR]\n"]
[1.65254,"o","   or: function [arguments]...\n"]
[1.652578,"o","\n"]
[1.652598,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[1.652633,"o","    utilities into a single executable.  Most people will create a\n"]
[1.652653,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[1.65267,"o","    will act like whatever it was invoked as.\n"]
[1.652688,"o","\n"]
[1.652705,"o","Currently defined functions:\n"]
[1.652723,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[1.65274,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[1.652758,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[1.652774,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[1.652791,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[1.652809,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[1.652826,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[1.652844,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[1.652862,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[1.652881,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[1.652899,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[1.652917,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[1.652935,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[1.652954,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[1.652972,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
