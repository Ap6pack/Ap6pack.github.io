[85.674085,"o","\n"]
[85.674102,"o","Usage: busybox [function] [arguments]...\n"]
[85.674119,"o","   or: busybox --list[-full]\n"]
[85.674136,"o","   or: busybox --install [-s] [DIR]\n"]
[85.674153,"o","   or: function [arguments]...\n"]
[85.67417,"o","\n"]
[85.674187,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[85.674204,"o","    utilities into a single executable.  Most people will create a\n"]
[85.674221,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[85.674238,"o","    will act like whatever it was invoked as.\n"]
[85.674255,"o","\n"]
[85.674272,"o","Currently defined functions:\n"]
[85.674288,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[85.674305,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[85.674322,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[85.674339,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[85.674356,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[85.674373,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[85.67439,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[85.674408,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
