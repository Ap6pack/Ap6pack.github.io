[88.26994,"o","\n"]
[88.269957,"o","Usage: busybox [function] [arguments]...\n"]
[88.269973,"o","   or: busybox --list[-full]\n"]
[88.26999,"o","   or: busybox --install [-s] [DIR]\n"]
[88.270007,"o","   or: function [arguments]...\n"]
[88.270024,"o","\n"]
[88.270041,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[88.270058,"o","    utilities into a single executable.  Most people will create a\n"]
[88.270075,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[88.270092,"o","    will act like whatever it was invoked as.\n"]
[88.270109,"o","\n"]
[88.270125,"o","Currently defined functions:\n"]
[88.270142,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[88.270159,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[88.270177,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[88.270195,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[88.270212,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
