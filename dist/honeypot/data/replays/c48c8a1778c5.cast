[92.471497,"o","\n"]
[92.471515,"o","Usage: busybox [function] [arguments]...\n"]
[92.471533,"o","   or: busybox --list[-full]\n"]
[92.471571,"o","   or: busybox --install [-s] [DIR]\n"]
[92.471596,"o","   or: function [arguments]...\n"]
[92.471613,"o","\n"]
[92.47163,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[92.471646,"o","    utilities into a single executable.  Most people will create a\n"]
[92.471663,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[92.47168,"o","    will act like whatever it was invoked as.\n"]
[92.471696,"o","\n"]
[92.471713,"o","Currently defined functions:\n"]
[92.471731,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[92.471747,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[92.471764,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[92.471781,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[92.471798,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[92.471815,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[92.471832,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[92.471851,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
