[72.499053,"o","\n"]
[72.499072,"o","Usage: busybox [function] [arguments]...\n"]
[72.49909,"o","   or: busybox --list[-full]\n"]
[72.499107,"o","   or: busybox --install [-s] [DIR]\n"]
[72.499124,"o","   or: function [arguments]...\n"]
[72.499141,"o","\n"]
[72.49916,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[72.499178,"o","    utilities into a single executable.  Most people will create a\n"]
[72.499196,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[72.499213,"o","    will act like whatever it was invoked as.\n"]
[72.49923,"o","\n"]
[72.499247,"o","Currently defined functions:\n"]
[72.499264,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[72.499285,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[72.499304,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[72.499321,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[72.499338,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
