[72.499373,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[72.499392,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
