[0.249968,"o","\n"]
[0.249984,"o","Usage: busybox [function] [arguments]...\n"]
[0.25,"o","   or: busybox --list[-full]\n"]
[0.250017,"o","   or: busybox --install [-s] [DIR]\n"]
[0.250033,"o","   or: function [arguments]...\n"]
[0.25005,"o","\n"]
[0.250066,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[0.250083,"o","    utilities into a single executable.  Most people will create a\n"]
[0.2501,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[0.250116,"o","    will act like whatever it was invoked as.\n"]
[0.250132,"o","\n"]
[0.250148,"o","Currently defined functions:\n"]
[0.250167,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[0.250185,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[0.250201,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[0.250218,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[0.250234,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[0.250251,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[0.250268,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[0.250287,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[0.250304,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[0.250321,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[0.250339,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[0.250355,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[0.250373,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[0.25039,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[0.250406,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[0.250423,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[0.25044,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
[0.250457,"o","    time, timeout, top, touch, tr, traceroute, traceroute6, true, tty,\n"]
[0.250474,"o","    udhcpc, udhcpd, umount, uname, uncompress, unexpand, uniq, unix2dos,\n"]
[0.250491,"o","    unlzma, unxz, unzip, uptime, usleep, uudecode, uuencode, vconfig, vi,\n"]
[0.250509,"o","    watch, watchdog, wc, wget, which, who, whoami, xargs, xz, xzcat, yes,\n"]
[0.250526,"o","    zcat\n"]
