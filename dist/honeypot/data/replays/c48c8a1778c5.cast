[78.926842,"o","Copyright (C) 1998-2011 Erik Andersen, Rob Landley, Denys Vlasenko\n"]
[78.926863,"o","and others. Licensed under GPLv2.\n"]
[78.926881,"o","See source distribution for full notice.\n"]
[78.926897,"o","\n"]
[78.926914,"o","Usage: busybox [function] [arguments]...\n"]
[78.926931,"o","   or: busybox --list[-full]\n"]
[78.926948,"o","   or: busybox --install [-s] [DIR]\n"]
[78.926965,"o","   or: function [arguments]...\n"]
[78.926981,"o","\n"]
[78.926998,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[78.927015,"o","    utilities into a single executable.  Most people will create a\n"]
[78.927032,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[78.927048,"o","    will act like whatever it was invoked as.\n"]
[78.927064,"o","\n"]
[78.927081,"o","Currently defined functions:\n"]
[78.927097,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
[78.927114,"o","    bunzip2, bzcat, bzip2, cal, cat, chgrp, chmod, chown, chroot, chvt,\n"]
[78.927131,"o","    clear, cmp, cp, cpio, cttyhack, cut, date, dc, dd, deallocvt, depmod,\n"]
[78.927147,"o","    df, diff, dirname, dmesg, dnsdomainname, dos2unix, du, dumpkmap,\n"]
[78.927164,"o","    dumpleases, echo, egrep, env, expand, expr, false, fgrep, find, fold,\n"]
[78.927197,"o","    free, freeramdisk, ftpget, ftpput, getopt, getty, grep, groups, gunzip,\n"]
[78.927216,"o","    gzip, halt, head, hexdump, hostid, hostname, httpd, hwclock, id,\n"]
[78.927233,"o","    ifconfig, init, insmod, ionice, ip, ipcalc, kill, killall, klogd, last,\n"]
[78.927251,"o","    less, ln, loadfont, loadkmap, logger, login, logname, logread, losetup,\n"]
[78.927268,"o","    ls, lsmod, lzcat, lzma, md5sum, mdev, microcom, mkdir, mkfifo, mknod,\n"]
[78.927285,"o","    mkswap, mktemp, modinfo, modprobe, more, mount, mt, mv, nameif, nc,\n"]
[78.927302,"o","    netstat, nslookup, od, openvt, patch, pidof, ping, ping6, pivot_root,\n"]
[78.92732,"o","    poweroff, printf, ps, pwd, rdate, readlink, realpath, reboot, renice,\n"]
[78.927338,"o","    reset, rev, rm, rmdir, rmmod, route, rpm, rpm2cpio, run-parts, sed, seq,\n"]
[78.927356,"o","    setkeycodes, setsid, sh, sha1sum, sha256sum, sha512sum, sleep, sort,\n"]
[78.927374,"o","    start-stop-daemon, stat, strings, stty, swapoff, swapon, switch_root,\n"]
[78.927392,"o","    sync, sysctl, syslogd, tac, tail, tar, taskset, tee, telnet, test, tftp,\n"]
