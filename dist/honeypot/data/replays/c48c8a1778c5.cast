[68.406598,"o","\n"]
[68.406617,"o","Usage: busybox [function] [arguments]...\n"]
[68.406634,"o","   or: busybox --list[-full]\n"]
[68.406652,"o","   or: busybox --install [-s] [DIR]\n"]
[68.406668,"o","   or: function [arguments]...\n"]
[68.406686,"o","\n"]
[68.406713,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[68.406734,"o","    utilities into a single executable.  Most people will create a\n"]
[68.406751,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[68.406768,"o","    will act like whatever it was invoked as.\n"]
[68.406785,"o","\n"]
[68.406803,"o","Currently defined functions:\n"]
[68.406823,"o","    [, [[, adjtimex, ar, arp, arping, ash, awk, basename, blockdev, brctl,\n"]
