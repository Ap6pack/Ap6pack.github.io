[94.937954,"o","\n"]
[94.937971,"o","Usage: busybox [function] [arguments]...\n"]
[94.937988,"o","   or: busybox --list[-full]\n"]
[94.938004,"o","   or: busybox --install [-s] [DIR]\n"]
[94.93802,"o","   or: function [arguments]...\n"]
[94.938036,"o","\n"]
[94.938053,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[94.938069,"o","    utilities into a single executable.  Most people will create a\n"]
[94.938086,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[94.938102,"o","    will act like whatever it was invoked as.\n"]
