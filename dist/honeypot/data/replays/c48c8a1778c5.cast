[79.96861,"o","\n"]
[79.968626,"o","Usage: busybox [function] [arguments]...\n"]
[79.968643,"o","   or: busybox --list[-full]\n"]
[79.968659,"o","   or: busybox --install [-s] [DIR]\n"]
[79.968675,"o","   or: function [arguments]...\n"]
[79.968692,"o","\n"]
[79.968708,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[79.968725,"o","    utilities into a single executable.  Most people will create a\n"]
[79.968741,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[79.968757,"o","    will act like whatever it was invoked as.\n"]
[79.968774,"o","\n"]
