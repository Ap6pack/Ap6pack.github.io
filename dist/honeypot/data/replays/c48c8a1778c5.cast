[89.056098,"o","\n"]
[89.056115,"o","Usage: busybox [function] [arguments]...\n"]
[89.056132,"o","   or: busybox --list[-full]\n"]
[89.056149,"o","   or: busybox --install [-s] [DIR]\n"]
[89.056165,"o","   or: function [arguments]...\n"]
[89.056182,"o","\n"]
[89.056199,"o","    BusyBox is a multi-call binary that combines many common Unix\n"]
[89.056233,"o","    utilities into a single executable.  Most people will create a\n"]
[89.05625,"o","    link to busybox for each function they wish to use and BusyBox\n"]
[89.056266,"o","    will act like whatever it was invoked as.\n"]
